@model DAL.ViewModels.TableAndSectionViewModel
@using DAL.ViewModels
@{
    var permissionList = new List<PermissionModel>();

    if (Context.Session.Get("permissions") != null)
    {
        permissionList = System.Text.Json.JsonSerializer.Deserialize<List<PermissionModel>>(Context.Session.Get("permissions"));
    }

}
@if (@Model.PageIndex > 0) {
    <input type="hidden" id="PageIndex" value="@Model.PageIndex" />
} else {
    <input type="hidden" id="PageIndex" value="1" />
}
<table id="userTable" class="table table-responsive" style="white-space: nowrap;">
    <thead class="color-head">
        <tr class="text-center">
            <th class="text-start mx-2">
                <input class="form-check-input intermediate-checkbox" type="checkbox" value=""
                    id="DeleteTablesIntermediateCheckbox" style="height: 1em;">
                <label class="form-check-label" for="flexCheckIndeterminate"></label>Name
            </th>
            <th>Capacity</th>
            <th>Status</th>
            @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && (x.CanEdit == true || x.CanDelete == true)))
            {
                <th>Action</th>
            }
        </thead>
    <tbody>
        @if (Model?.Tables?.Count() == 0)
        {
            <tr>
                <td colspan="4" class="text-center font-weight-bold-slight">No tables available</td>
            </tr>
        }
        @foreach (var table in Model.Tables)
        {
            <tr class="text-center">
                <td class="text-start mx-2 d-flex align-items-center table-checkbox-gap">
                    <input class="form-check-input permission-checkbox table-name-checkbox" type="checkbox" value="@table.Id"
                        style="height: 1em;" onclick="addToList(@table.Id)">
                    <label class="form-check-label" for="defaultCheck1">@table.Name
                </td>
                <td>@table.Capacity</td>
                <td>
                    @if (table.Status == "Available")
                    {
                        <span class="available-table">@table.Status</span>
                    }
                    else if (table.Status == "Assigned" || table.Status == "Running")  
                    {
                        <span class="occupied-table">Occupied</span>
                    }
                </td>
                <td>
                    @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanEdit == true))
                    {
                        <button type="button" onclick="editTableFunc(@table.Id)" class="edit-btn btn">
                            <a> <img src="~/images/icons/edit.svg" class="small-image" alt=""></a></button>
                    }
                    @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanDelete == true))
                    {
                        <button type="button" class="delete-btn" data-bs-toggle="modal" data-bs-target="#deleteTable" onclick="deleteTableId(@table.Id)">
                            <a> <img src="~/images/icons/delete.svg" class="small-image" alt=""></a></button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="d-flex flex-column flex flex-sm-row align-items-center justify-content-end g-3">
    <div class="d-flex align-items-center gap-2">
        <p>Items per page: </p>
        <select class="form-select pagination-dropdown text-black" aria-label="Items per page"
            onchange="changePageSize(this.value)">
            <option value="5" selected="@(Model.PageSize == 5 ? "selected" : null)">5</option>
            <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
            <option value="15" selected="@(Model.PageSize == 15 ? "selected" : null)">15</option>
        </select>
    </div>
    <p class="px-1">
        Showing @(Model.TotalPages == 0 ? 0 : (Model.PageIndex - 1) * Model.PageSize + 1) -
        @(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalTables)) of
        @Model.TotalTables
    </p>
    <div class="d-flex gap-2 gap-sm-0">
        <button id="previousButton" class="p-1 px-2" @(Model.PageIndex == 1 ? "disabled" : "")>&lt;</button>
        <button id="nextButton" class="p-1 px-2 ms-1 border-1 border-secondary" @(((Model.PageIndex == Model.TotalPages) || Model.TotalPages == 0) ? "disabled" : "")> &gt;</ button >
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script>
    pageSizeOfModal = @Model.PageSize;
    var pageIndexOfModal = @Model.PageIndex;
</script>
<script src="~/js/tablesAndSectionsTablePartial.js"></script>