@model DAL.ViewModels.TableAndSectionViewModel
@using DAL.ViewModels
@{
    var permissionList = new List<PermissionModel>();

    if (Context.Session.Get("permissions") != null)
    {
        permissionList = System.Text.Json.JsonSerializer.Deserialize<List<PermissionModel>>(Context.Session.Get("permissions"));
    }

}

<div class="d-none d-md-block col-md-4 col-lg-3 col-xxl-2 bg-menu-category height-main-container">
        <div class="d-flex justify-content-between p-3">
            <h4 class="font-blue">Section</h4>
            @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanEdit == true))
            {
                <button type="button" class="delete-btn" data-bs-toggle="modal" data-bs-target="#addSectionModal">
                    <a> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image" alt=""></a>
                </button>
            }
        </div>
        <div class="d-flex flex-column  category-list-styles ">
            @foreach (var Section in Model.Sections)
            {
                var divCustomIdTable = "divTable" + @Section.Id;
                var divCustomIdTable2 = "divTable" + @Section.Id + "two";
                var divCustomId4 = "divTable" + @Section.Id + "four";
                var blueDotId = "blueDotTable" + @Section.Id;
                var grayDotId = "grayDotTable" + @Section.Id;

                @if (@Model.Sections[0].Id == @Section.Id)
                {
                    <div onmouseenter="showDiv(@divCustomIdTable)" onmouseleave="hideDiv(@divCustomIdTable)"
                        onclick="changeTables(@Section.Id)" id="@divCustomIdTable2"
                        class="d-flex justify-content-between align-items-center cursor-pointer p-2">
                        <div>
                            <img src="~/images/icons/gray-six-dots.svg" id="@grayDotId" class="small-image d-none gray-dot-table" alt="">
                            <img src="~/images/icons/blue-six-dots.svg" id="@blueDotId" class="small-image blue-dot-table" alt="">
                            <span class="menu-category-navigation-items-table active-nav-item" id="@divCustomId4">@Section.Name</span>
                        </div>
                        <div id="@divCustomIdTable" class="d-none">
                            @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanEdit == true))
                            {
                                <button type="button" class="delete-btn bg-white" onclick="editSection(@Section.Id)">
                                    <a> <img src="~/images/icons/edit.svg" class="small-image " alt=""></a>
                                </button>
                            }
                            @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanDelete == true))
                            {
                                <button type="button" class="delete-btn bg-white" data-bs-toggle="modal" data-bs-target="#deleteSectionModal" onclick="deleteSection(@Section.Id)">
                                    <a> <img src="~/images/icons/delete.svg" class="small-image" alt=""></a>
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div onmouseenter="showDiv(@divCustomIdTable)" onmouseleave="hideDiv(@divCustomIdTable)"
                        onclick="changeTables(@Section.Id)" id="@divCustomIdTable2"
                        class="d-flex justify-content-between align-items-center cursor-pointer p-2">
                        <div>
                            <img src="~/images/icons/gray-six-dots.svg" id="@grayDotId" class="small-image gray-dot-table" alt="">
                            <img src="~/images/icons/blue-six-dots.svg" id="@blueDotId" class="small-image d-none blue-dot-table" alt="">
                            <span class="menu-category-navigation-items-table" id="@divCustomId4">@Section.Name</span>
                        </div>
                        <div id="@divCustomIdTable" class="d-none">
                            @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanEdit == true))
                            {
                                <button type="button" class="delete-btn bg-white" onclick="editSection(@Section.Id)">
                                    <a> <img src="~/images/icons/edit.svg" class="small-image " alt=""></a>
                                </button>
                            }
                            @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanDelete == true))
                            {
                                <button type="button" class="delete-btn bg-white" data-bs-toggle="modal" data-bs-target="#deleteSectionModal" onclick="deleteSection(@Section.Id)">
                                    <a> <img src="~/images/icons/delete.svg" class="small-image" alt=""></a>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <div class="accordion col-12 d-block d-md-none" id="accordionExample">
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingOne">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne"> Sections
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne"
                data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    <div class="d-block d-lg-none p-3 col-lg-3 bg-menu-category">
                        <div class="d-flex justify-content-between">
                            <h4 class="font-blue">Sections</h4>
                            @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanEdit == true))
                            {
                                <button type="button" class="delete-btn" data-bs-toggle="modal" data-bs-target="#addSectionModal">
                                    <a> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image" alt=""></a>
                                </button>
                            }
                        </div>
                        <div class="d-flex flex-column gap-2 mt-2 mt-sm-3 mt-md-5">
                            @foreach (var Section in Model.Sections)
                            {
                                <div class="d-flex justify-content-between align-items-center cursor-pointer p-2" onclick="changeTables(@Section.Id)">
                                    <div>
                                        <img src="~/images/icons/gray-six-dots.svg" id="sandwich-black-dots"
                                            class="small-image " alt="">
                                        <img src="~/images/icons/blue-six-dots.svg" id="sandwich-blue-dot-tables d-none" style="display: none;" class="small-image" alt="">
                                        <span class="menu-category-navigation-items" id="sandwich-span">@Section.Name</span>
                                    </div>
                                    <div>
                                        @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanEdit == true))
                                        {
                                            <button type="button" class="delete-btn bg-white" onclick="editSection(@Section.Id)">
                                                <a> <img src="~/images/icons/edit.svg" class="small-image " alt=""></a>
                                            </button>
                                        }
                                        @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanDelete == true))
                                        {
                                            <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                                                data-bs-target="#deleteSectionModal" onclick="deleteSection(@Section.Id)">
                                                <a> <img src="~/images/icons/delete.svg" class="small-image" alt=""></a>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-8 col-lg-9">
        <div class="d-flex menu-mobile-header-div justify-content-between pt-3 pt-sm-2 align-items-center">
            <h4 class="px-sm-4 py-2">Tables</h4>
            <div class="d-flex justify-content-center gap-2 align-items-center mx-3">
                <div class="input-group search-box d-none d-md-block">
                    <input type="text" id="searchInput" onchange="" class="form-control search-input py-1 py-sm-2"
                        placeholder="Search">
                    <img src="~/images/icons/search-icon.svg" class="small-image anchor-tag  search-icon" alt="">
                </div>
                <p class="delete-styles d-none" id="search-icon" onclick="showSearchBar()">
                    <a class="text-decoration-none text-black add-user-link">
                        <img src="~/images/icons/search-header.svg" class="p-2 menu-category-image-delete" alt="">
                    </a>
                </p>
                <div id="mobile-search-bar" class="input-group search-box d-none d-md-none">
                    <input id="searchInput2" type="text" class="form-control search-input py-1 py-sm-2"
                        placeholder="Search">
                    <img src="~/images/icons/search-icon.svg" class="small-image anchor-tag  search-icon" alt="">
                </div>
                @if(permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanDelete == true))
                {
                    <p class="delete-styles" data-bs-toggle="modal" data-bs-target="#deleteTables">
                        <a class="text-decoration-none text-black   add-user-link">
                            <img src="~/images/icons/delete-header.svg" class="p-2  menu-category-image-delete" alt="">
                        </a>
                    </p>
                }
                @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanEdit == true))
                {
                    <p class="delete-styles d-block d-md-none d-flex justify-content-center align-items-center"
                        onclick="openAddTableModal()" style="width: 49px; height: 49px;">
                        <button class="text-decoration-none text-black btn  add-user-link">
                            <img src="~/images/icons/plus-header.svg" class="p-2 menu-category-image-delete" alt="">
                        </button>
                    </p>
                    <button id="AddTableModal" onclick="openAddTableModal()"
                        class="d-none d-md-block button-styles-header w-100 add-item-button">
                        <a
                            class="text-decoration-none text-white add-user-link gap-2 d-flex justify-content-center">
                            <p>+</p>
                            <p class="d-none d-sm-block">New Table</p>
                        </a>
                    </button>
                }
            </div>
        </div>

        <div class="table-responsive col-12 form-bg mx-4 p-3 mb-3 mx-auto">
            <div id="tablePartialView" class="">
                <partial name="_TablePartial" model="@Model" />
            </div>
        </div>
    </div>

    @* add table modal *@
<div class="modal fade" id="addTableModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered table-modal">
        <div class="modal-content">
            <form id="AddTableModalForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="addTableTitle">Add Table</h5>
                    <button onclick="clearAddTableForm()" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row align-items-center">
                        <div class="col-12 row">
                            <div class="form-floating my-auto col-12 col-md-6">
                                <input type="hidden" id="TableId" value="-1" />
                                <input asp-for="@Model.AddTableViewModal.TableName" type="text" class="form-control" name="AddTableViewModal.TableName" id="TableName" required
                                    placeholder="ItemName">
                                <label for="ItemName" class="">Name*</label>
                                <span asp-validation-for="AddTableViewModal.TableName" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6 p-2 form-floating">
                                <select readonly id="TableSection" class="form-select cursor-none" aria-label="CategoryId" style="background-color: #E9ECEF">
                                    @foreach (var Section in Model.Sections)
                                    {
                                        <option disabled value="@Section.Id">@Section.Name</option>
                                    }
                                </select>
                                <span id="TableSectionError" class="text-danger"></span>
                                <label for="CategoryId" class="mx-2 mt-2">Section*</label>
                            </div>
                        </div>
                        <div class="col-12 row">
                            <div class="form-floating my-auto col-12 col-md-6">
                                <input asp-for="@Model.AddTableViewModal.TableCapacity" type="text" class="form-control" name="AddTableViewModal.TableCapacity" id="TableCapacity" required
                                    placeholder="ItemName">
                                <label for="ItemName" class="">Capacity*</label>
                                <span asp-validation-for="AddTableViewModal.TableCapacity" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6 p-2 form-floating">
                                <select readonly id="TableStatus" class="form-select cursor-none" aria-label="CategoryId" style="background-color: #E9ECEF">
                                    <option disabled value="Available">Available</option>
                                    <option disabled value="Occupied">Occupied</option>
                                </select>
                                <label for="CategoryId" class="mx-2 mt-2">Status*</label>
                                <span id="TableStatusError" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-end ">
                    <button id="AddTableButton" onclick="addTable()" type="button"
                        class="btn btn-primary px-3">Save</button>
                    <a onclick="clearAddTableForm()" data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">No</button></a>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script src="~/js/tablesAndSectionsPartialSections.js"></script>