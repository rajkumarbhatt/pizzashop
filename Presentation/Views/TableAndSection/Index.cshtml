@model DAL.ViewModels.TableAndSectionViewModel
@using DAL.ViewModels
@{
    var permissionList = new List<PermissionModel>();

    if (Context.Session.Get("permissions") != null)
    {
        permissionList = System.Text.Json.JsonSerializer.Deserialize<List<PermissionModel>>(Context.Session.Get("permissions"));
    }

}
<div class="d-flex justify-content-between align-items-center">
    <h1 class="main-page-heading">Sections/Tables</h1>
</div>
<input class="d-none" id="SectionId" value="@Model.Tables[0].SectionId" />
<div id="items-content" class=" form-bg p-2 my-1 row mx-4 ">
    <div class="d-none d-md-block col-md-4 col-lg-3 col-xxl-2 bg-menu-category height-main-container">
        <div class="d-flex justify-content-between p-3">
            <h4 class="font-blue">Section</h4>
            @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanEdit == true))
            {
                <button type="button" class="delete-btn" data-bs-toggle="modal" data-bs-target="#addSectionModal">
                    <a> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image" alt=""></a>
                </button>
            }
        </div>
        <div class="d-flex flex-column  category-list-styles ">
            @foreach (var Section in Model.Sections)
            {
                var divCustomIdTable = "divTable" + @Section.Id;
                var divCustomIdTable2 = "divTable" + @Section.Id + "2";
                var divCustomId4 = "divTable" + @Section.Id + "4";
                var blueDotId = "blueDotTable" + @Section.Id;
                var grayDotId = "grayDotTable" + @Section.Id;

                @if (@Model.Sections[0].Id == @Section.Id)
                {
                    <div onmouseenter="showDiv(@divCustomIdTable)" onmouseleave="hideDiv(@divCustomIdTable)"
                        onclick="changeTables(@Section.Id)" id="@divCustomIdTable2"
                        class="d-flex justify-content-between align-items-center cursor-pointer p-2">
                        <div>
                            <img src="~/images/icons/gray-six-dots.svg" id="@grayDotId" class="small-image d-none gray-dot-table" alt="">
                            <img src="~/images/icons/blue-six-dots.svg" id="@blueDotId" class="small-image blue-dot-table" alt="">
                            <span class="menu-category-navigation-items-table active-nav-item" id="@divCustomId4">@Section.Name</span>
                        </div>
                        <div id="@divCustomIdTable" class="d-none">
                            @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanEdit == true))
                            {
                                <button type="button" class="delete-btn bg-white" onclick="editSection(@Section.Id)">
                                    <a> <img src="~/images/icons/edit.svg" class="small-image " alt=""></a>
                                </button>
                            }
                            @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanDelete == true))
                            {
                                <button type="button" class="delete-btn bg-white" data-bs-toggle="modal" data-bs-target="#deleteSectionModal" onclick="deleteSection(@Section.Id)">
                                    <a> <img src="~/images/icons/delete.svg" class="small-image" alt=""></a>
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div onmouseenter="showDiv(@divCustomIdTable)" onmouseleave="hideDiv(@divCustomIdTable)"
                        onclick="changeTables(@Section.Id)" id="@divCustomIdTable2"
                        class="d-flex justify-content-between align-items-center cursor-pointer p-2">
                        <div>
                            <img src="~/images/icons/gray-six-dots.svg" id="@grayDotId" class="small-image gray-dot-table" alt="">
                            <img src="~/images/icons/blue-six-dots.svg" id="@blueDotId" class="small-image d-none blue-dot-table" alt="">
                            <span class="menu-category-navigation-items-table" id="@divCustomId4">@Section.Name</span>
                        </div>
                        <div id="@divCustomIdTable" class="d-none">
                            @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanEdit == true))
                            {
                                <button type="button" class="delete-btn bg-white" onclick="editSection(@Section.Id)">
                                    <a> <img src="~/images/icons/edit.svg" class="small-image " alt=""></a>
                                </button>
                            }
                            @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanDelete == true))
                            {
                                <button type="button" class="delete-btn bg-white" data-bs-toggle="modal" data-bs-target="#deleteSectionModal" onclick="deleteSection(@Section.Id)">
                                    <a> <img src="~/images/icons/delete.svg" class="small-image" alt=""></a>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <div class="accordion col-12 d-block d-md-none" id="accordionExample">
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingOne">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne"> Sections
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne"
                data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    <div class="d-block d-lg-none p-3 col-lg-3 bg-menu-category">
                        <div class="d-flex justify-content-between">
                            <h4 class="font-blue">Sections</h4>
                            @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanEdit == true))
                            {
                                <button type="button" class="delete-btn" data-bs-toggle="modal" data-bs-target="#addSectionModal">
                                    <a> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image" alt=""></a>
                                </button>
                            }
                        </div>
                        <div class="d-flex flex-column gap-2 mt-2 mt-sm-3 mt-md-5">
                            @foreach (var Section in Model.Sections)
                            {
                                <div class="d-flex justify-content-between align-items-center cursor-pointer p-2" onclick="changeTables(@Section.Id)">
                                    <div>
                                        <img src="~/images/icons/gray-six-dots.svg" id="sandwich-black-dots"
                                            class="small-image " alt="">
                                        <img src="~/images/icons/blue-six-dots.svg" id="sandwich-blue-dot-tables d-none" style="display: none;" class="small-image" alt="">
                                        <span class="menu-category-navigation-items" id="sandwich-span">@Section.Name</span>
                                    </div>
                                    <div>
                                        @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanEdit == true))
                                        {
                                            <button type="button" class="delete-btn bg-white" onclick="editSection(@Section.Id)">
                                                <a> <img src="~/images/icons/edit.svg" class="small-image " alt=""></a>
                                            </button>
                                        }
                                        @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanDelete == true))
                                        {
                                            <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                                                data-bs-target="#deleteSectionModal" onclick="deleteSection(@Section.Id)">
                                                <a> <img src="~/images/icons/delete.svg" class="small-image" alt=""></a>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-8 col-lg-9">
        <div class="d-flex menu-mobile-header-div justify-content-between pt-3 pt-sm-2 align-items-center">
            <h4 class="px-sm-4 py-2">Tables</h4>
            <div class="d-flex justify-content-center gap-2 align-items-center mx-3">
                <div class="input-group search-box d-none d-md-block">
                    <input type="text" id="searchInput" onchange="" class="form-control search-input py-1 py-sm-2"
                        placeholder="Search">
                    <img src="~/images/icons/search-icon.svg" class="small-image anchor-tag  search-icon" alt="">
                </div>
                <p class="delete-styles d-bloack d-md-none" id="search-icon" onclick="showSearchBar()">
                    <a class="text-decoration-none text-black add-user-link">
                        <img src="~/images/icons/search-header.svg" class="p-2 menu-category-image-delete" alt="">
                    </a>
                </p>
                <div id="mobile-search-bar" class="input-group search-box d-none d-md-none">
                    <input id="searchInput2" type="text" class="form-control search-input py-1 py-sm-2"
                        placeholder="Search">
                    <img src="~/images/icons/search-icon.svg" class="small-image anchor-tag  search-icon" alt="">
                </div>
                @if(permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanDelete == true))
                {
                    <p class="delete-styles" data-bs-toggle="modal" data-bs-target="#deleteTables">
                        <a class="text-decoration-none text-black   add-user-link">
                            <img src="~/images/icons/delete-header.svg" class="p-2  menu-category-image-delete" alt="">
                        </a>
                    </p>
                }
                @if (permissionList != null && permissionList.Any(x => x.Name == "TableAndSection" && x.CanEdit == true))
                {
                    <p class="delete-styles d-block d-md-none d-flex justify-content-center align-items-center"
                        data-bs-toggle="modal" data-bs-target="#addTableModal" style="width: 49px; height: 49px;">
                        <button class="text-decoration-none text-black btn  add-user-link">
                            <img src="~/images/icons/plus-header.svg" class="p-2 menu-category-image-delete" alt="">
                        </button>
                    </p>
                    <button id="AddTableModal" onclick="openAddTableModal()"
                        class="d-none d-md-block button-styles-header w-100 add-item-button">
                        <a
                            class="text-decoration-none text-white add-user-link gap-2 d-flex justify-content-center">
                            <p>+</p>
                            <p class="d-none d-sm-block">New Table</p>
                        </a>
                    </button>
                }
            </div>
        </div>

        <div class="table-responsive col-12 form-bg mx-4 p-3 mb-3 mx-auto">
            <div id="tablePartialView" class="">
                <partial name="_TablePartial" model="@Model" />
            </div>
        </div>
    </div>
</div>

@* add section modal *@
<div class="modal fade" id="addSectionModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <input type="hidden" id="SectionIdModal" value="-1" />
            <div class="modal-header">
                <h5 id="addSectionModalTitle" class="modal-title" id="staticBackdropLabel">Add Section
                </h5>
                <button onclick="clearAddSectionForm()" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="category-name" id="SectionName" required
                        placeholder="name">
                    <label for="category-name" class="">Name*</label>
                    <span id="SectionNameError" class="text-danger"></span>
                </div>
                <div class="form-floating">
                    <input type="text" class="form-control" name="category-description" id="SectionDescription" required
                        placeholder="category-description">
                    <label for="category-description" class="">Description</label>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <button id="AddSectionButton" onclick="addSection()" type="submit"
                    class="btn btn-primary px-3">Save</button>
                <a onclick="clearAddSectionForm()" data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>

@* delete section modal *@
<div class="modal fade" id="deleteSectionModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex align-items-center flex-column">
                <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete this section?</p>
            </div>
            <div class="modal-footer d-flex justify-content-center">
                <button id="deleteSectionButton" type="button" class="btn btn-primary px-3"
                    data-bs-dismiss="modal">Yes</button>
                <a asp-controller="Menu" asp-action="Index"><button type="button"
                        class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>

@* delete tables modal *@
<div class="modal fade" id="deleteTables" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete
                    Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column align-items-center justify-content-center">
                <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete these tables?</p>
            </div>
            <div class="modal-footer">
                <button id="deleteModifierButton" onclick="deleteSelectedTables()" type="button"
                    class="btn btn-primary px-3" data-bs-dismiss="modal">Yes</button>
                <a data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">No</button></a>
            </div>
        </div>
    </div>
</div>

@* delete table modal *@
<div class="modal fade" id="deleteTable" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete
                    Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column align-items-center justify-content-center">
                <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete this table?</p>
            </div>
            <div class="modal-footer">
                <button id="deleteTableButton" type="button" class="btn btn-primary px-3"
                    data-bs-dismiss="modal">Yes</button>
                <a data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">No</button></a>
            </div>
        </div>
    </div>
</div>

@* add table modal *@
<div class="modal fade" id="addTableModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered table-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addTableTitle">Add Table</h5>
                <button onclick="clearAddTableForm()" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row align-items-center">
                    <div class="col-12 row">
                        <div class="form-floating my-auto col-12 col-md-6">
                            <input type="hidden" id="TableId" value="-1" />
                            <input type="text" class="form-control" name="" id="TableName" required
                                placeholder="ItemName">
                            <span id="TableNameError" class="text-danger"></span>
                            <label for="ItemName" class="">Name*</label>
                        </div>
                        <div class="col-12 col-md-6 p-2 form-floating">
                            <select readonly id="TableSection" class="form-select cursor-none" aria-label="CategoryId" style="background-color: #E9ECEF">
                                @foreach (var Section in Model.Sections)
                                {
                                    <option disabled value="@Section.Id">@Section.Name</option>
                                }
                            </select>
                            <span id="TableSectionError" class="text-danger"></span>
                            <label for="CategoryId" class="mx-2 mt-2">Section*</label>
                        </div>
                    </div>
                    <div class="col-12 row">
                        <div class="form-floating my-auto col-12 col-md-6">
                            <input type="text" class="form-control" name="" id="TableCapacity" required
                                placeholder="ItemName">
                            <span id="TableCapacityError" class="text-danger"></span>
                            <label for="ItemName" class="">Capacity*</label>
                        </div>
                        <div class="col-12 col-md-6 p-2 form-floating">
                            <select readonly id="TableStatus" class="form-select cursor-none" aria-label="CategoryId" style="background-color: #E9ECEF">
                                <option disabled value="Available">Available</option>
                                <option disabled value="Occupied">Occupied</option>
                            </select>
                            <span id="TableStatusError" class="text-danger"></span>
                            <label for="CategoryId" class="mx-2 mt-2">Status*</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end ">
                <button id="AddTableButton" onclick="addTable()" type="button"
                    class="btn btn-primary px-3">Save</button>
                <a onclick="clearAddTableForm()" data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">No</button></a>
            </div>
        </div>
    </div>
</div>


<script>

    var deleteTableIds = [];

    function showDiv(divId) {
        divId.classList.remove('d-none');
        var divId2 = divId.id + "2";
        $("#" + divId2).addClass('active-category-div'); 
    }

    function hideDiv(divId) {
        divId.classList.add('d-none');
        var divId2 = divId.id + "2";
        $("#" + divId2).removeClass('active-category-div');
    }

    function addSection() {
        var sectionName = document.getElementById("SectionName").value;
        if (sectionName == "") {
            document.getElementById("SectionNameError").innerText = "Section Name is required.";
            return;
        }
        var sectionId = document.getElementById("SectionIdModal").value;
        var sectionDescription = document.getElementById("SectionDescription").value;
        $.ajax({
            type: "POST",
            url: '@Url.Action("AddSection", "TableAndSection")',
            data: { sectionName: sectionName, sectionDescription: sectionDescription, sectionId: sectionId },
            success: function (response) {
                if (response.success) {
                    toastr.success(response.message);
                    setTimeout(function () {
                        location.reload();
                        clearAddSectionForm();
                    }, 1000);
                } else {
                    toastr.error(response.message);
                }
            },
            error: function (response) {
                toastr.error("Unauthorized Access");
            }
        });
    }

    function editSection(sectionId) {
        $.ajax({
            type: "GET",
            url: '@Url.Action("EditSection", "TableAndSection")',
            data: { sectionId: sectionId },
            success: function (response) {
                document.getElementById("SectionName").value = response.name;
                document.getElementById("SectionDescription").value = response.description;
                document.getElementById("SectionIdModal").value = sectionId;
                $("#addSectionModalTitle").text("Edit Section");
                $("#addSectionModal").modal("show");
            },
            error: function (response) {
                toastr.error("Unauthorized Access");
            }
        });
    }

    let isDeletingSections = false;
    function deleteSection(sectionId) {
        if (isDeletingSections) return;
        isDeletingSections = true;
        $("#deleteSectionButton").off("click").click(function () {
            $.ajax({
                type: "DELETE",
                url: '@Url.Action("DeleteSection", "TableAndSection")',
                data: { sectionId: sectionId },
                success: function (response) {
                    isDeletingSections = false;
                    if (response.success) {
                        toastr.success(response.message);
                        setTimeout(function () {
                            location.reload();
                        }, 1000);
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function (response) {
                    isDeletingSections = false;
                    toastr.error("Unauthorized Access");
                }
            });
        });  
    }

    let isDeletingTables = false;
    function deleteSelectedTables() {
        if (isDeletingTables) return;
        isDeletingTables = true;

        if (!deleteTableIds || deleteTableIds.length === 0) {
            toastr.error("No tables selected for deletion.");
            isDeletingTables = false;  
            return;
        }

        $.ajax({
            type: "DELETE",
            url: '@Url.Action("DeleteTables", "TableAndSection")',
            data: { tableIds: deleteTableIds },
            success: function (response) {
                isDeletingTables = false;  
                if (response.success) {
                    toastr.success(response.message);
                    deleteTableIds = [];
                    $.ajax({
                        type: "GET",
                        url: '@Url.Action("TablesFilter", "TableAndSection")',
                        data: { pageIndex: 1, pageSize: @Model.PageSize, sectionId: $("#SectionId").val(), searchValue: $("#searchInput").val() },
                        success: function (data) {
                            $("#tablePartialView").html(data);
                        }
                    });
                } else {
                    toastr.error(response.message);
                }
            },
            error: function (response) {
                isDeletingTables = false;
                toastr.error("An error occurred. Please try again.");
                console.error("Error response: ", response);
            }
        });
    }

    
    function deleteTableId(id) {
        $("#deleteTableButton").off("click").click(function () {
            $.ajax({
                type: "DELETE",
                url: '@Url.Action("DeleteTable", "TableAndSection")',
                data: { tableId: id },
                success: function (response) {
                    if (response.success) {
                        toastr.success(response.message);
                        $.ajax({
                            type: "GET",
                            url: '@Url.Action("TablesFilter", "TableAndSection")',
                            data: { pageIndex: $("#PageIndex").val(), pageSize: @Model.PageSize, sectionId: $("#SectionId").val()},
                            success: function (data) {
                                $("#tablePartialView").html(data);
                                $("#searchInput").val("");
                            }
                        });
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function (response) {
                    toastr.error("Unauthorized Access");
                }
            });
        });
    }

    $(document).ready(function () {
        $("#TableName").on("input", function () {
            if ($("#TableName").val() != "") {
                document.getElementById("TableNameError").innerText = "";
            } else {
                document.getElementById("TableNameError").innerText = "Table Name is required.";
            }
        });

        $("#TableCapacity").on("input", function () {
            if ($("#TableCapacity").val() == "") {
                document.getElementById("TableCapacityError").innerText = "Table Capacity is required.";
            } else if ($("#TableCapacity").val() != "" && !/^[0-9]+$/.test($("#TableCapacity").val())) {
                document.getElementById("TableCapacityError").innerText = "Table Capacity should be a number.";
            } else {
                document.getElementById("TableCapacityError").innerText = "";
            }
        });
    });

    function makeThisSectionActive (sectionId) {
        var divCustomIdTable = "divTable" + sectionId;
        var divCustomIdTable2 = "divTable" + sectionId + "2";
        var divCustomId4 = "divTable" + sectionId + "4";
        var blueDotId = "blueDotTable" + sectionId;
        var grayDotId = "grayDotTable" + sectionId;
        $(".blue-dot-table").addClass('d-none');
        $(".gray-dot-table").removeClass('d-none');
        $(".active-category-div").removeClass('active-category-div');
        $(".active-nav-item").removeClass('active-nav-item');
        $("#" + divCustomId4).addClass('active-nav-item');
        $("#" + blueDotId).removeClass('d-none');
        $("#" + grayDotId).addClass('d-none');
        $("#SectionId").val(sectionId);
    }

    function addTable() {
        var tableName = document.getElementById("TableName").value;
        var tableSection = document.getElementById("TableSection").value;
        var tableCapacity = document.getElementById("TableCapacity").value;
        var tableStatus = document.getElementById("TableStatus").value;
        var tableId = document.getElementById("TableId").value;
        if (tableName == "") {
            document.getElementById("TableNameError").innerText = "Table Name is required.";
            return;
        }
        if (tableSection == "") {
            document.getElementById("TableSectionError").innerText = "Table Section is required.";
            return;
        }
        if (tableCapacity == "") {
            document.getElementById("TableCapacityError").innerText = "Table Capacity is required.";
            return;
        }
        var pageIndex = $("#PageIndex").val();
        $.ajax({
            type: "POST",
            url: '@Url.Action("AddTable", "TableAndSection")',
            data: { tableId: tableId, tableName: tableName, sectionId: tableSection, tableCapacity: tableCapacity, tableStatus: tableStatus },
            success: function (response) {
                if (response.success) {
                    toastr.success(response.message);
                    clearAddTableForm();
                    $.ajax({
                        type: "GET",
                        url: '@Url.Action("TablesFilter", "TableAndSection")',
                        data: { pageIndex: pageIndex, pageSize: @Model.PageSize, sectionId: tableSection, searchValue: $("#searchInput").val() },
                        success: function (data) {
                            $("#tablePartialView").html(data);
                            makeThisSectionActive(tableSection);
                        }
                    });
                    $("#addTableModal").modal("hide");
                } else {
                    toastr.error(response.message);
                }
            },
            error: function (response) {
                toastr.error("Unauthorized Access");
            }
        });
    }

    
    $(document).on('keydown', function (e) {
        if (e.key === "Delete") {
            deleteSelectedTables();
        }
    });

    function clearAddTableForm() {
        document.getElementById("TableId").value = "-1";
        document.getElementById("TableName").value = "";
        document.getElementById("TableSection").value = 1;
        document.getElementById("TableCapacity").value = "";
        document.getElementById("TableStatus").value = "Available";
        document.getElementById("TableNameError").innerText = "";
        document.getElementById("TableSectionError").innerText = "";
        document.getElementById("TableCapacityError").innerText = "";
        document.getElementById("TableStatusError").innerText = "";
        document.getElementById("addTableTitle").innerText = "Add Table";   
    }

    function clearAddSectionForm() {
        document.getElementById("SectionIdModal").value = "-1";
        document.getElementById("SectionName").value = "";
        document.getElementById("SectionDescription").value = "";
        document.getElementById("SectionNameError").innerText = "";
        document.getElementById("addSectionModalTitle").innerText = "Add Section";
    }

    function openAddTableModal () {
        var sectionId = document.getElementById("SectionId").value;
        if (sectionId == "") {
            toastr.error("Please select a section first.");
            return;
        }
        document.getElementById("TableSection").value = sectionId;
        document.getElementById("TableStatus").value = "Available";
        $("#addTableModal").modal("show");
    }

</script>