@model DAL.ViewModels.TableAndSectionViewModel

<div class="d-flex justify-content-between align-items-center">
    <h1 class="main-page-heading">Sections/Tables</h1>
</div>
<input class="d-none" id="SectionId" value="@Model.Tables[0].SectionId" />
<div id="items-content" class=" form-bg p-2 my-1 row mx-4 ">
    <div class="d-none d-md-block col-md-4 col-lg-3 col-xxl-2 bg-menu-category height-main-container">
        <div class="d-flex justify-content-between p-3">
            <h4 class="font-blue">Section</h4>
            <button type="button" class="delete-btn" data-bs-toggle="modal" data-bs-target="#addSectionModal">
                <a href="#"> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image" alt=""></a>
            </button>
        </div>
        <div class="d-flex flex-column  mt-2 mt-sm-3 mt-md-4 category-list-styles ">
            @foreach (var Section in Model.Sections)
            {
                var divCustomId = "div" + @Section.Id;
                <div onmouseenter="showDiv(@divCustomId)" onmouseleave="hideDiv(@divCustomId)"
                    onclick="changeTables(@Section.Id)"
                    class="d-flex justify-content-between align-items-center cursor-pointer p-2">
                    <div>
                        <img src="~/images/icons/gray-six-dots.svg" id="sandwich-black-dots" class="small-image " alt="">
                        <img src="~/images/icons/blue-six-dots.svg d-none" id="sandwich-blue-dots" class="small-image"
                            alt="">
                        <span class="menu-category-navigation-items" id="sandwich-span">@Section.Name</span>
                    </div>
                    <div id="@divCustomId" class="d-none">

                        <button type="button" class="delete-btn bg-white" onclick="editSection(@Section.Id)">
                            <a href="#"> <img src="~/images/icons/edit.svg" class="small-image " alt=""></a>
                        </button>
                        <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                            data-bs-target="#deleteSectionModal" onclick="deleteSection(@Section.Id)">
                            <a href="#"> <img src="~/images/icons/delete.svg" class="small-image" alt=""
                                    id="sandwich-delete-icon"></a>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="accordion col-12 d-block d-md-none" id="accordionExample">
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingOne">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne"> Sections
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne"
                data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    <div class="d-block d-lg-none p-3 col-lg-3 bg-menu-category">
                        <div class="d-flex justify-content-between">
                            <h4 class="font-blue">Sections</h4>
                            <button type="button" class="delete-btn" data-bs-toggle="modal"
                                data-bs-target="#addSectionModal">
                                <a href="#"> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image"
                                        alt=""></a>
                            </button>
                        </div>
                        <div class="d-flex flex-column gap-2 mt-2 mt-sm-3 mt-md-5">
                            @foreach (var Section in Model.Sections)
                            {
                                <div class="d-flex justify-content-between align-items-center cursor-pointer p-2">
                                    <div>
                                        <img src="~/images/icons/gray-six-dots.svg" id="sandwich-black-dots"
                                            class="small-image " alt="">
                                        <img src="~/images/icons/blue-six-dots.svg d-none" id="sandwich-blue-dots"
                                            class="small-image" alt="">
                                        <span class="menu-category-navigation-items" id="sandwich-span">@Section.Name</span>
                                    </div>
                                    <div>
                                        <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                                            data-bs-target="#editCategoryModal">
                                            <a href="#"> <img src="~/images/icons/edit.svg" class="small-image " alt=""></a>
                                        </button>
                                        <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                                            data-bs-target="#categoryDeleteModal">
                                            <a href="#"> <img src="~/images/icons/delete.svg" class="small-image" alt=""
                                                    id="sandwich-delete-icon"></a>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-8 col-lg-9">
        <div class="d-flex menu-mobile-header-div justify-content-between pt-3 pt-sm-2 align-items-center">
            <h4 class="px-sm-4 py-2">Tables</h4>
            <div class="d-flex justify-content-center gap-2 align-items-center mx-3">
                <div class="input-group search-box d-none d-md-block">
                    <input type="text" id="searchInput" onchange="" class="form-control search-input py-1 py-sm-2"
                        placeholder="Search">
                    <img src="~/images/icons/search-icon.svg" class="small-image anchor-tag  search-icon" alt="">
                </div>
                <p class="delete-styles d-bloack d-md-none" id="search-icon" onclick="showSearchBar()">
                    <a href="#" class="text-decoration-none text-black add-user-link">
                        <img src="~/images/icons/search-header.svg" class="p-2 menu-category-image-delete" alt="">
                    </a>
                </p>
                <div id="mobile-search-bar" class="input-group search-box d-none d-md-none">
                    <input id="searchInput2" type="text" class="form-control search-input py-1 py-sm-2"
                        placeholder="Search">
                    <img src="~/images/icons/search-icon.svg" class="small-image anchor-tag  search-icon" alt="">
                </div>
                <p class="delete-styles" data-bs-toggle="modal" data-bs-target="#deleteTables">
                    <a href="#" class="text-decoration-none text-black   add-user-link">
                        <img src="~/images/icons/delete-header.svg" class="p-2  menu-category-image-delete" alt="">
                    </a>
                </p>
                <p class="delete-styles d-block d-md-none d-flex justify-content-center align-items-center"
                    data-bs-toggle="modal" data-bs-target="#addTableModal" style="width: 49px; height: 49px;">
                    <button class="text-decoration-none text-black btn  add-user-link">
                        <img src="~/images/icons/plus-header.svg" class="p-2 menu-category-image-delete" alt="">
                    </button>
                </p>
                <button data-bs-toggle="modal" data-bs-target="#addTableModal" id="AddItemModal" onclick="addItem()"
                    class="d-none d-md-block button-styles-header w-100 add-item-button">
                    <a href="#"
                        class="text-decoration-none text-white add-user-link gap-2 d-flex justify-content-center">
                        <p>+</p>
                        <p class="d-none d-sm-block">New Table</p>
                    </a>
                </button>
            </div>
        </div>

        <div class="table-responsive col-12 form-bg mx-4 p-3 my-3 mx-auto">
            <div id="tablePartialView" class="">
                <partial name="_TablePartial" model="@Model" />
            </div>
        </div>
    </div>
</div>

@* add section modal *@
<div class="modal fade" id="addSectionModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <input type="hidden" id="SectionIdModal" value="-1" />
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Add Section
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="category-name" id="SectionName" required
                        placeholder="name">
                    <label for="category-name" class="">Name*</label>
                    <span id="SectionNameError" class="text-danger"></span>
                </div>
                <div class="form-floating">
                    <input type="text" class="form-control" name="category-description" id="SectionDescription" required
                        placeholder="category-description">
                    <label for="category-description" class="">Description</label>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <button id="AddSectionButton" onclick="addSection()" type="submit"
                    class="btn btn-primary px-3">Save</button>
                <a asp-controller="Menu" asp-action="Index"><button type="button"
                        class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>

@* delete section modal *@
<div class="modal fade" id="deleteSectionModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex align-items-center flex-column">
                <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete this section?</p>
            </div>
            <div class="modal-footer d-flex justify-content-center">
                <button id="deleteSectionButton" type="button" class="btn btn-primary px-3"
                    data-bs-dismiss="modal">Yes</button>
                <a asp-controller="Menu" asp-action="Index"><button type="button"
                        class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>

@* delete tables modal *@
<div class="modal fade" id="deleteTables" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete
                    Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column align-items-center justify-content-center">
                <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete these tables?</p>
            </div>
            <div class="modal-footer">
                <button id="deleteModifierButton" onclick="deleteSelectedTables()" type="button"
                    class="btn btn-primary px-3" data-bs-dismiss="modal">Yes</button>
                <a data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">No</button></a>
            </div>
        </div>
    </div>
</div>

@* delete table modal *@
<div class="modal fade" id="deleteTable" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete
                    Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column align-items-center justify-content-center">
                <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete this table?</p>
            </div>
            <div class="modal-footer">
                <button id="deleteTableButton" type="button" class="btn btn-primary px-3"
                    data-bs-dismiss="modal">Yes</button>
                <a data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">No</button></a>
            </div>
        </div>
    </div>
</div>

@* add table modal *@
<div class="modal fade" id="addTableModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered table-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Add Table
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row align-items-center">
                    <div class="col-12 row">
                        <div class="form-floating my-auto col-12 col-md-6">
                            <input type="hidden" id="TableId" value="-1" />
                            <input type="text" class="form-control" name="" id="TableName" required placeholder="ItemName">
                            <span id="TableNameError" class="text-danger"></span>
                            <label for="ItemName" class="">Name*</label>
                        </div>
                        <div class="col-12 col-md-6 p-2 form-floating">
                            <select id="TableSection" class="form-select" aria-label="CategoryId"> 
                                @foreach (var Section in Model.Sections)
                                {
                                    <option value="@Section.Id">@Section.Name</option>
                                } 
                            </select>
                            <span id="TableSectionError" class="text-danger"></span>
                            <label for="CategoryId" class="mx-2 mt-2">Section*</label>
                        </div>
                    </div>
                    <div class="col-12 row">
                        <div class="form-floating my-auto col-12 col-md-6">
                            <input type="text" class="form-control" name="" id="TableCapacity" required placeholder="ItemName">
                            <span id="TableCapacityError" class="text-danger"></span>
                            <label for="ItemName" class="">Capacity*</label>
                        </div>
                        <div class="col-12 col-md-6 p-2 form-floating">
                            <select id="TableStatus" class="form-select" aria-label="CategoryId"> 
                                <option value="Available">Available</option>
                                <option value="Occupied">Occupied</option>
                            </select>
                            <span id="TableStatusError" class="text-danger"></span>
                            <label for="CategoryId" class="mx-2 mt-2">Status*</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end ">
                <button id="AddTableButton" onclick="addTable()" type="button" class="btn btn-primary px-3">Save</button>
                <a data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">No</button></a>
            </div>
        </div>


        <script>

            var deleteTableIds = [];

            function showDiv(divId) {
                divId.classList.remove('d-none');
            }

            function hideDiv(divId) {
                divId.classList.add('d-none');
            }

            function addSection() {
                var sectionName = document.getElementById("SectionName").value;
                if (sectionName == "") {
                    document.getElementById("SectionNameError").innerText = "Section Name is required.";
                    return;
                }
                var sectionId = document.getElementById("SectionIdModal").value;
                var sectionDescription = document.getElementById("SectionDescription").value;
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("AddSection", "TableAndSection")',
                    data: { sectionName: sectionName, sectionDescription: sectionDescription, sectionId: sectionId },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message);
                            setTimeout(function () {
                                location.reload();
                            }, 1000);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function (response) {
                        toastr.error("Unauthorized Access");
                    }
                });
            }

            function editSection(sectionId) {
                $.ajax({
                    type: "GET",
                    url: '@Url.Action("EditSection", "TableAndSection")',
                    data: { sectionId: sectionId },
                    success: function (response) {
                        console.log(response);
                        document.getElementById("SectionName").value = response.name;
                        document.getElementById("SectionDescription").value = response.description;
                        document.getElementById("SectionIdModal").value = sectionId;
                        $("#addSectionModal").modal("show");
                    },
                    error: function (response) {
                        toastr.error("Unauthorized Access");
                    }
                });
            }

            function deleteSection(sectionId) {
                $("#deleteSectionButton").click(function () {
                    $.ajax({
                        type: "DELETE",
                        url: '@Url.Action("DeleteSection", "TableAndSection")',
                        data: { sectionId: sectionId },
                        success: function (response) {
                            if (response.success) {
                                toastr.success(response.message);
                                setTimeout(function () {
                                    location.reload();
                                }, 1000);
                            } else {
                                toastr.error(response.message);
                            }
                        },
                        error: function (response) {
                            toastr.error("Unauthorized Access");
                        }
                    });
                });
            }

            function deleteSelectedTables() {
                $.ajax({
                    type: "DELETE",
                    url: '@Url.Action("DeleteTables", "TableAndSection")',
                    data: { tableIds: deleteTableIds },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message);
                            setTimeout(function () {
                                location.reload();
                            }, 1000);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function (response) {
                        toastr.error("Unauthorized Access");
                    }
                });
            }

            function deleteTableId(id) {
                $("#deleteTableButton").click(function () {
                    $.ajax({
                        type: "DELETE",
                        url: '@Url.Action("DeleteTable", "TableAndSection")',
                        data: { tableId: id },
                        success: function (response) {
                            if (response.success) {
                                toastr.success(response.message);
                                setTimeout(function () {
                                    location.reload();
                                }, 1000);
                            } else {
                                toastr.error(response.message);
                            }
                        },
                        error: function (response) {
                            toastr.error("Unauthorized Access");
                        }
                    });
                });
            }
        
            function addTable() {
                var tableName = document.getElementById("TableName").value;
                var tableSection = document.getElementById("TableSection").value;
                var tableCapacity = document.getElementById("TableCapacity").value;
                var tableStatus = document.getElementById("TableStatus").value;
                var tableId = document.getElementById("TableId").value;
                if (tableName == "") {
                    document.getElementById("TableNameError").innerText = "Table Name is required.";
                    return;
                }
                if (tableSection == "") {
                    document.getElementById("TableSectionError").innerText = "Table Section is required.";
                    return;
                }
                if (tableCapacity == "") {
                    document.getElementById("TableCapacityError").innerText = "Table Capacity is required.";
                    return;
                }
                if (tableStatus == "") {
                    document.getElementById("TableStatusError").innerText = "Table Status is required.";
                    return;
                }
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("AddTable", "TableAndSection")',
                    data: { tableId: tableId, tableName: tableName, sectionId: tableSection, tableCapacity: tableCapacity, tableStatus: tableStatus },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message);
                            setTimeout(function () {
                                location.reload();
                            }, 1000);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function (response) {
                        toastr.error("Unauthorized Access");
                    }
                });
            }

            
        </script>