@model DAL.ViewModels.TableAndSectionViewModel
@using DAL.ViewModels
@{
    var permissionList = new List<PermissionModel>();

    if (Context.Session.Get("permissions") != null)
    {
        permissionList = System.Text.Json.JsonSerializer.Deserialize<List<PermissionModel>>(Context.Session.Get("permissions"));
    }

}
<div class="d-flex justify-content-between align-items-center">
    <h1 class="main-page-heading">Sections/Tables</h1>
</div>
<input class="d-none" id="SectionId" value="@Model.Tables[0].SectionId" />
<div id="items-content" class=" form-bg p-2 my-1 row mx-4 ">
    <partial name="_SectionsPartial" model="Model" />
</div>

@* add section modal *@
<div class="modal fade" id="addSectionModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <input type="hidden" id="SectionIdModal" value="-1" />
            <div class="modal-header">
                <h5 id="addSectionModalTitle" class="modal-title" id="staticBackdropLabel">Add Section
                </h5>
                <button onclick="clearAddSectionForm()" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="category-name" id="SectionName" required
                        placeholder="name">
                    <label for="category-name" class="">Name*</label>
                    <span id="SectionNameError" class="text-danger"></span>
                </div>
                <div class="form-floating">
                    <input type="text" class="form-control" name="category-description" id="SectionDescription" required
                        placeholder="category-description">
                    <label for="category-description" class="">Description</label>
                    <span id="SectionDescriptionError" class="text-danger"></span>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <button id="AddSectionButton" onclick="addSection()" type="submit"
                    class="btn btn-primary px-3">Save</button>
                <a onclick="clearAddSectionForm()" data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>

@* delete section modal *@
<div class="modal fade" id="deleteSectionModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex align-items-center flex-column">
                <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete this section?</p>
            </div>
            <div class="modal-footer d-flex justify-content-center">
                <button id="deleteSectionButton" type="button" class="btn btn-primary px-3"
                    data-bs-dismiss="modal">Yes</button>
                <a asp-controller="Menu" asp-action="Index"><button type="button"
                        class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>

@* delete tables modal *@
<div class="modal fade" id="deleteTables" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete
                    Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column align-items-center justify-content-center">
                <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete these tables?</p>
            </div>
            <div class="modal-footer">
                <button id="deleteModifierButton" onclick="deleteSelectedTables()" type="button"
                    class="btn btn-primary px-3" data-bs-dismiss="modal">Yes</button>
                <a data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">No</button></a>
            </div>
        </div>
    </div>
</div>

@* delete table modal *@
<div class="modal fade" id="deleteTable" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete
                    Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column align-items-center justify-content-center">
                <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete this table?</p>
            </div>
            <div class="modal-footer">
                <button id="deleteTableButton" type="button" class="btn btn-primary px-3"
                    data-bs-dismiss="modal">Yes</button>
                <a data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">No</button></a>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script>
    var deleteTableIds = [];
    var pageSizeOfModal = @Model.PageSize;
    var sectionIdFromModal = @Model.Sections[0].Id;
</script>
<script src="~/js/tablesAndSections.js"></script>