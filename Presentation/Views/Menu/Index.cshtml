@model DAL.ViewModels.MenuViewModel
<div class="d-flex justify-content-between align-items-center">
    <h1 class="main-page-heading">Menu</h1>
</div>

<!-- table -->
<div class="d-none d-md-block form-bg p-2 my mx-4 ">
    <div class="d-flex mb-2 items-div ">
        <div class="d-flex cursor-pointer active-menu-item" id="items-div" onclick="changeLine('items-div')">
            <img src="./images/icons/menu.svg" id="blue-menu" class="extra-small-image mx-1" alt="">
            <img src="./images/icons/menu-black.svg" id="black-menu" class="extra-small-image mx-1 d-none" alt="">
            <p>Items</p>
        </div>
        <div class="d-flex mx-4 modifiers-div cursor-pointer" id="modifiers-div" onclick="changeLine('modifiers-div')">
            <img src="./images/icons/black-modifier.svg" id="black-modifier" class="extra-small-image mx-1" alt="">
            <img src="./images/icons/blue-modifier.svg" id="blue-modifier" class="extra-small-image mx-1 d-none" alt="">
            <p>Modifiers</p>
        </div>
    </div>
</div>
<p class="underline-para" id="underline-para"></p>


<div class=" form-bg p-2 my-1 row mx-4 ">
    <div class="d-none d-md-block col-md-4 col-lg-3 col-xxl-2 bg-menu-category height-main-container">
        <div class="d-flex justify-content-between p-3">
            <h4 class="font-blue">Category</h4>
            <button type="button" class="delete-btn" data-bs-toggle="modal" data-bs-target="#categoryModal">
                <a href="#"> <img src="./images/icons/plus-with-border.svg" class="menu-category-image" alt=""></a>
            </button>
        </div>
        <div class="d-flex flex-column  mt-2 mt-sm-3 mt-md-4 category-list-styles ">
            @foreach (var category in Model.Categories)
            {
                <div class="d-flex justify-content-between align-items-center cursor-pointer p-2">
                    <div>
                        <img src="./images/icons/gray-six-dots.svg" id="sandwich-black-dots" class="small-image "
                            alt="">
                        <img src="./images/icons/blue-six-dots.svg d-none" id="sandwich-blue-dots" class="small-image" alt="">
                        <span class="menu-category-navigation-items"
                            id="sandwich-span">@category.Name</span>
                    </div>
                    <div>
                        <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                            data-bs-target="#editCategoryModal">
                            <a href="#"> <img src="./images/icons/edit.svg" class="small-image " alt="" onclick="editCategory('@category.Id', '@category.Name', '@category.Description')"></a>
                        </button>
                        <button type="button" class="delete-btn bg-white" data-bs-toggle="modal" data-bs-target="#categoryDeleteModal" onclick="openModal('@category.Id')">
                            <a href="#"> <img src="./images/icons/delete.svg" class="small-image" alt=""
                                    id="sandwich-delete-icon"></a>
                        </button>
                    </div>
                </div>
            }
        </div>
