            <div class="modal-footer d-flex justify-content-center">
                <button id="deleteCategoryButton" type="button" class="btn btn-primary px-3" data-bs-dismiss="modal">Yes</button>
                <a asp-controller="Menu" asp-action="Index"><button type="button" class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>
