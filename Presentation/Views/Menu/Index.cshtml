@model DAL.ViewModels.MenuViewModel
<div class="d-flex justify-content-between align-items-center">
    <h1 class="main-page-heading">Menu</h1>
</div>

<!-- table -->
<div class="d-none d-md-block form-bg p-2 my mx-4 ">
    <div class="d-flex mb-2 items-div ">
        <div class="d-flex cursor-pointer active-menu-item" id="items-div" onclick="changeLine('items-div')">
            <img src="./images/icons/menu.svg" id="blue-menu" class="extra-small-image mx-1" alt="">
            <img src="./images/icons/menu-black.svg" id="black-menu" class="extra-small-image mx-1 d-none" alt="">
            <p>Items</p>
        </div>
        <div class="d-flex mx-4 modifiers-div cursor-pointer" id="modifiers-div" onclick="changeLine('modifiers-div')">
            <img src="./images/icons/black-modifier.svg" id="black-modifier" class="extra-small-image mx-1" alt="">
            <img src="./images/icons/blue-modifier.svg" id="blue-modifier" class="extra-small-image mx-1 d-none" alt="">
            <p>Modifiers</p>
        </div>
    </div>
</div>
<p class="underline-para" id="underline-para"></p>

<div id="partialViewStarting" class="">

    <partial name="_MenuPartial" model="@Model" />


    <div id="modifiers-content" class="d-none col-md-8 col-12 col-lg-9 col-xl-10">
        <h4 class="px-4 py-2">Modifiers</h4>


        <div class="table-responsive col-12 form-bg mx-4 p-3 my-3 mx-auto">
            <table id="userTable" class="table table-responsive" style="white-space: nowrap;">
                <thead class="color-head">
                    <tr class="text-center">
                        <th class="text-start mx-2"> <input class="form-check-input intermediate-checkbox"
                                type="checkbox" value="" id="flexCheckIndeterminate">
                            <label class="form-check-label" for="flexCheckIndeterminate"></label>Name
                        </th>
                        <th>Item type</th>
                        <th>Rate</th>
                        <th>Quantity</th>
                        <th>Available</th>
                        <th>Action</th>
                </thead>
                <tbody>
                    <tr class="text-center">
                        <td class="text-start mx-2 d-flex align-items-center table-checkbox-gap"><input
                                class="form-check-input permission-checkbox" type="checkbox" value=""
                                id="defaultCheck1">
                            <img src="./images/dining-menu.png" style="width: 35px;" alt="">
                            <label class="form-check-label" for="defaultCheck1">Punjabi Tadka Sandwich
                        </td>
                        <td>
                            <img src="./images/icons/non-veg-icon.svg" class="small-image" alt="">
                        </td>
                        <td>200</td>
                        <td>10</td>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="flexSwitchCheckChecked" checked>
                            </div>
                        </td>
                        <td>
                            <a href="./editUser.html"> <img src="./images/icons/edit.svg" class="small-image"
                                    alt=""></a>
                            <button type="button" class="delete-btn" data-bs-toggle="modal"
                                data-bs-target="#staticBackdrop">
                                <a href="#"> <img src="./images/icons/delete.svg" class="small-image"
                                        alt=""></a></button>

                            <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static"
                                data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel"
                                aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="staticBackdropLabel">Delete
                                                Confirmation
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <img src="./images/icons/warning.svg" class="medium-image" alt="">
                                            <p>Are you sure you want to delete this item?</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-primary px-3"
                                                data-bs-dismiss="modal">Yes</button>
                                            <a href="./menu.html"><button type="button"
                                                    class="btn btn-contrast px-3">No</button></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>
</div>
</div>
</div>


@* edit category *@
<div class="modal fade" id="editCategoryModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Edit Category
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-floating mb-3">
                    <input id="EditCategoryId" class="d-none">
                    <input type="text" class="form-control" name="category-name" id="EditCategoryName" required
                        placeholder="name">
                    <label for="category-name" class="">Name</label>
                </div>
                <div class="form-floating">
                    <input type="text" class="form-control" name="category-description" id="EditCategoryDescription"
                        required placeholder="category-description">
                    <label for="category-description" class="">Description</label>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <button id="EditCategoryModal" type="button" class="btn btn-primary px-3"
                    data-bs-dismiss="modal">Save</button>
                <a asp-controller="Menu" asp-action="Index"><button type="button"
                        class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>

@* add category *@
<div class="modal fade" id="categoryModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Add Category
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="category-name" id="CategoryName" required
                        placeholder="name">
                    <label for="category-name" class="">Name</label>
                </div>
                <div class="form-floating">
                    <input type="text" class="form-control" name="category-description" id="CategoryDescription"
                        required placeholder="category-description">
                    <label for="category-description" class="">Description</label>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <button id="AddCategoryModal" type="submit" class="btn btn-primary px-3">Save</button>
                <a asp-controller="Menu" asp-action="Index"><button type="button"
                        class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="categoryDeleteModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex align-items-center flex-column">
                <img src="./images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete this category?</p>
            </div>
            <div class="modal-footer d-flex justify-content-center">
                <button id="deleteCategoryButton" type="button" class="btn btn-primary px-3"
                    data-bs-dismiss="modal">Yes</button>
                <a asp-controller="Menu" asp-action="Index"><button type="button"
                        class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>

@* delete item *@
<div class="modal fade" id="deleteItem" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete
                    Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column align-items-center justify-content-center">
                <img src="./images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete this item?</p>
            </div>
            <div class="modal-footer">
                <button id="deleteItemButton" type="button" class="btn btn-primary px-3" data-bs-dismiss="modal">Yes</button>
                <a href="./menu.html"><button type="button" class="btn btn-contrast px-3">No</button></a>
            </div>
        </div>
    </div>
</div>

<script src="~/js/menu.js" asp-append-version="true"></script>