@model DAL.ViewModels.MenuViewModel

<div class="d-none d-md-block col-md-4 col-lg-3 col-xxl-2 bg-menu-category height-main-container">
    <div class="d-flex justify-content-between p-3">
        <h4 class="font-blue">Modifiers</h4>
        <button type="button" class="delete-btn" data-bs-toggle="modal" data-bs-target="#AddModifierGroupModal">
            <a href="#"> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image" alt=""></a>
        </button>
    </div>
    <div class="d-flex flex-column  mt-2 mt-sm-3 mt-md-4 category-list-styles ">
        @foreach (var modifierGroup in Model.ModifierGroups)
        {
            <div onclick="changeModifiers(@modifierGroup.Id)"
                class="d-flex justify-content-between align-items-center cursor-pointer p-2">
                <div>
                    <img src="~/images/icons/gray-six-dots.svg" id="sandwich-black-dots" class="small-image " alt="">
                    <img src="~/images/icons/blue-six-dots.svg d-none" id="sandwich-blue-dots" class="small-image" alt="">
                    <span class="menu-category-navigation-items" id="sandwich-span">@modifierGroup.Name</span>
                </div>
                <div>
                    <button type="button" class="delete-btn bg-white">
                        <a href="#"> <img src="~/images/icons/edit.svg" class="small-image " alt=""
                                onclick="editModifierGroup(@modifierGroup.Id)"></a>
                    </button>
                    <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                        data-bs-target="#deleteModifierGroup" onclick="deleteModifierGroupFunc(@modifierGroup.Id)">
                        <a href="#"> <img src="~/images/icons/delete.svg" class="small-image" alt=""
                                id="sandwich-delete-icon"></a>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<div class="col-12 col-md-8 col-lg-9">
    <div class="d-flex menu-mobile-header-div justify-content-between pt-3 pt-sm-2 align-items-center">
        <h4 class="px-sm-4 py-2">Modifiers</h4>
        <div class="d-flex justify-content-center gap-2 align-items-center mx-3">
            <div class="input-group search-box d-none d-md-block">
                <input type="text" id="searchInputModifier" class="form-control search-input py-1 py-sm-2"
                    placeholder="Search">
                <img src="~/images/icons/search-icon.svg" class="small-image anchor-tag  search-icon" alt="">
            </div>
            <p class="delete-styles d-bloack d-md-none" id="search-icon-modifier" onclick="showSearchBar()">
                <a href="#" class="text-decoration-none text-black add-user-link">
                    <img src="~/images/icons/search-header.svg" class="p-2 menu-category-image-delete" alt="">
                </a>
            </p>
            <div id="mobile-search-bar" class="input-group search-box d-none d-md-none">
                <input id="searchInputModifierMobile" type="text" class="form-control search-input py-1 py-sm-2"
                    placeholder="Search">
                <img src="~/images/icons/search-icon.svg" class="small-image anchor-tag  search-icon" alt="">
            </div>
            <p class="delete-styles ">
                <a href="#" class="text-decoration-none text-black   add-user-link">
                    <img src="~/images/icons/delete-header.svg" class="p-2  menu-category-image-delete" alt="">
                </a>
            </p>
            <p class="delete-styles d-block d-md-none d-flex justify-content-center align-items-center"
                data-bs-toggle="modal" data-bs-target="#addModifierModal" style="width: 49px; height: 49px;">
                <button class="text-decoration-none text-black btn  add-user-link">
                    <img src="~/images/icons/plus-header.svg" class="p-2 menu-category-image-delete" alt="">
                </button>
            </p>
            <button id="AddItemModal" onclick="addModifier()"
                class="d-none d-md-block button-styles-header w-100 add-item-button">
                <a href="#" class="text-decoration-none text-white add-user-link gap-2 d-flex justify-content-center">
                    <p>+</p>
                    <p class="d-none d-sm-block">Add Modifier</p>
                </a>
            </button>
        </div>
    </div>

    <div class="table-responsive col-12 form-bg mx-4 p-3 my-3 mx-auto">


        <div id="ModifiersTablePartial" class="">


            <partial name="_ModifiersTable" model="@Model" />

        </div>
    </div>

@* delete modifiergroup modal *@
    <div class="modal fade" id="deleteModifierGroup" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel1">Delete Confirmation
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex align-items-center flex-column">
                    <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                    <p>Are you sure you want to delete this modifier group?</p>
                </div>
                <div class="modal-footer d-flex justify-content-center">
                    <button id="deleteModifierGroupButton" type="button" class="btn btn-primary px-3"
                        data-bs-dismiss="modal">Yes</button>
                    <a data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">Cancel</button></a>
                </div>
            </div>
        </div>
    </div>

@* add modifier group modal *@
    <div class="modal fade" id="AddModifierGroupModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-add-modifier-group modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">Add Modifier Group</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="">
                        <div class="row">
                            <div class="col-12">
                                <div class="form-floating my-auto">
                                    <input type="text" asp-for="@Model.CreateModifierGroupViewModel.ModifierGroupName"
                                        class="form-control" name="Model.CreateModifierGroupViewModel.ModifierGroupName"
                                        id="AddModifierName" required placeholder="name">
                                    <label for="category-name" class="">Name*</label>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 mt-2 mb-3">
                                <div class="form-floating my-auto">
                                    <input type="text"
                                        asp-for="@Model.CreateModifierGroupViewModel.ModifierGroupDescription"
                                        class="form-control"
                                        name="Model.CreateModifierGroupViewModel.ModifierGroupDescription"
                                        id="AddModifierDescription" required placeholder="Description*">
                                    <label for="category-description" class="">Description*</label>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" id="ModifierIdsAddModifierGroup"
                            asp-for="@Model.CreateModifierGroupViewModel.SelectedModifierIds"
                            name="Model.CreateModifierGroupViewModel.SelectedModifierIds" />
                        @if(Model.CreateModifierGroupViewModel != null && Model.CreateModifierGroupViewModel.ModifierGroupId != 0)
                        {
                            <input type="hidden" id="ModifierGroupId"
                                asp-for="@Model.CreateModifierGroupViewModel.ModifierGroupId"
                                name="Model.CreateModifierGroupViewModel.ModifierGroupId" value="@Model.CreateModifierGroupViewModel.ModifierGroupId"/>
                        } else {
                            <input type="hidden" id="ModifierGroupId"
                                asp-for="@Model.CreateModifierGroupViewModel.ModifierGroupId"
                                name="Model.CreateModifierGroupViewModel.ModifierGroupId" value="0"/>
                        }
                        <a onclick="openModalAllModifiers()" class="text-decoration-none cursor-pointer">+ Add Existing
                            Modifiers</a>
                        <div id="modifiersSelected" class="d-flex flex-wrap mt-2 ">
                            @if(Model.CreateModifierGroupViewModel != null && Model.CreateModifierGroupViewModel.SelectedModifierIds != null)
                            {
                                foreach (var modifier in Model.CreateModifierGroupViewModel.Modifiers)
                                {
                                    <script>
                                        addTagCustom(@modifier.Id, '@modifier.Name');
                                        selectedModifiers.push({
                                            id: @modifier.Id,
                                            name: '@modifier.Name'
                                        });
                                        document.querySelectorAll(".tag-delete").forEach(tag => {
                                            tag.addEventListener("click", function () {
                                                const modifierId = this.parentElement.getAttribute("data-value");
                                                const index = selectedModifiers.findIndex(x => x.id === parseInt(modifierId));
                                                selectedModifiers.splice(index, 1);
                                                this.parentElement.remove();
                                                console.log(selectedModifiers);
                                            });
                                        });
                                    </script>
                                }
                            }
                        </div>
                    </form>
                </div>
                <div class="modal-footer d-flex justify-content-end">
                    <button type="button" id="AddModifierButton" class="btn btn-primary px-3"
                        data-bs-dismiss="modal">Save</button>
                    <a data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">Cancel</button></a>
                </div>
            </div>
        </div>
    </div>

@* add modifier group modal 2 *@
    <div class="modal fade" id="AddModifierGroupModal2" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-add-modifier-group modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">Select Existing Modifier(s)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-6">
                            <div class="input-group search-box">
                                <input id="searchInputAllModifiers" type="text"
                                    class="form-control search-input py-1 py-sm-2" placeholder="Search">
                                <img src="./images/icons/search-icon.svg" class="small-image anchor-tag  search-icon"
                                    alt="">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="table-responsive col-12 form-bg mx-4  mx-auto">
                                <div id="allModifiersPartial">
                                    <partial name="_AllModifiersPartial" model="@Model" />
                                </div>
                            </div>
                            <div class="modal-footer d-flex justify-content-end">
                                <button onclick="addModalsToList()" type="button" class="btn btn-primary px-3"
                                    data-bs-dismiss="modal">Save</button>
                                <a data-bs-dismiss="modal"><button type="button"
                                        class="btn btn-contrast px-3">Cancel</button></a>
                            </div>
                        </div>
                    </div>
                </div>

<script>
    function editModifierGroup(modifierGroupId) {
        $.ajax({
            url: '@Url.Action("EditModifierGroup", "Menu")',
            type: 'GET',
            data: { modifierGroupId: modifierGroupId },
            success: function (data) {
                $("#modifiers-content").html(data);
                $("#AddModifierGroupModal").modal("show");
                console.log($("#ModifierIdsAddModifierGroup").val());
            },
            error: function (error) {
                console.log(error);
            }
        });
    }

    $("#AddModifierButton").click(function () {
        var name = $("#AddModifierName").val();
        var description = $("#AddModifierDescription").val();
        var modifierIds = selectedModifiers.map(x => x.id);
        var modifierGroupId = $("#ModifierGroupId").val();
        $.ajax({
            url: '@Url.Action("AddModifierGroup", "Menu")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ ModifierGroupName: name, ModifierGroupDescription: description, SelectedModifierIds: modifierIds, ModifierGroupId: modifierGroupId }),
            success: function (data) {
                if (data.success) {
                    toastr.success(data.message);
                    setTimeout(function () {
                        location.reload();
                    }, 1000);
                } else {
                    toastr.error(data.message);
                }
            }
        });
    });
</script>