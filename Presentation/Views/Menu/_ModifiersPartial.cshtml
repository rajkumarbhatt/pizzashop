@using DAL.ViewModels
@model DAL.ViewModels.MenuViewModel
@{
    var permissionList = new List<PermissionModel>();

    if (Context.Session.Get("permissions") != null)
    {
        permissionList = System.Text.Json.JsonSerializer.Deserialize<List<PermissionModel>>(Context.Session.Get("permissions"));
    }

}
@if(Model.AddModifierViewModel != null && Model.AddModifierViewModel.ModifierGroupIds != null)
{
    <script>
        var selectedModifiersGroupsAddModifier2 = @Html.Raw(Json.Serialize(Model.AddModifierViewModel.ModifierGroupIds));
        debugger
        selectedModifiersGroupsAddModifier2 = selectedModifiersGroupsAddModifier2.map(x => parseInt(x));
        $("#AddModifierModifierGroupIds").val(selectedModifiersGroupsAddModifier2);
        selectedModifiersGroupsAddModifier2.forEach(x => {
            var customId = "AddModifier" + x;
            $("#" + customId).prop("checked", true);
        });
    </script>
}
<div class="d-none d-md-block col-md-4 col-lg-3 col-xxl-2 bg-menu-category height-main-container">
    <div class="d-flex justify-content-between p-3">
        <h4 class="font-blue">Modifiers</h4>
        @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
        {
            <button type="button" class="delete-btn" onclick="addModigierGroupFunc()" data-bs-toggle="modal" data-bs-target="#AddModifierGroupModal">
                <a> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image" alt=""></a>
            </button>
        }
        else 
        {
            <button type="button" class="delete-btn cursor-none" >
                <a class="cursor-none"> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image cursor-none" alt=""></a>
            </button>
        }
    </div>
    <div class="d-flex flex-column  category-list-styles">
        @foreach (var modifierGroup in Model.ModifierGroups)
        {
            var divCustomId = "modifierGroup" + modifierGroup.Id;
            var divCustomId2 = "modifierGroup" + modifierGroup.Id + "2";
            <div onmouseenter="showDiv(@divCustomId)" onmouseleave="hideDiv(@divCustomId)" onclick="changeModifiers(@modifierGroup.Id)" id="@divCustomId2"
                class="d-flex justify-content-between align-items-center cursor-pointer p-2">
                <div>
                    <img src="~/images/icons/gray-six-dots.svg" class="small-image " alt="">
                    <img src="~/images/icons/blue-six-dots.svg"  class="small-image d-none" alt="">
                    <span class="menu-category-navigation-items" >@modifierGroup.Name</span>
                </div>
                <div id="@divCustomId" class="d-none">
                    @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
                    {
                        <button type="button" class="delete-btn bg-white">
                            <a> <img src="~/images/icons/edit.svg" class="small-image " alt="" onclick="editModifierGroup(@modifierGroup.Id)"></a>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="delete-btn bg-white cursor-none">
                            <a class="cursor-none"> <img src="~/images/icons/edit.svg" class="small-image cursor-none" alt=""></a>
                        </button>
                    }
                    @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanDelete == true))
                    {
                        <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                            data-bs-target="#deleteModifierGroup" onclick="deleteModifierGroupFunc(@modifierGroup.Id)">
                            <a> <img src="~/images/icons/delete.svg" class="small-image" alt="" id="delete-icon"></a>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="delete-btn bg-white cursor-none">
                            <a class="cursor-none"> <img src="~/images/icons/delete.svg" class="small-image cursor-none" alt="" id="delete-icon"></a>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>
<div class="accordion col-12 d-block d-md-none" id="accordionExample">
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingOne">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne"> Modifiers
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne"
                data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    <div class="d-block d-lg-none p-3 col-lg-3 bg-menu-category">
                        <div class="d-flex justify-content-between">
                            <h4 class="font-blue">Modifier Group</h4>
                            @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
                            {
                                <button type="button" class="delete-btn" onclick="addModigierGroupFunc()" data-bs-toggle="modal" data-bs-target="#AddModifierGroupModal">
                                    <a> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image" alt=""></a>
                                </button>
                            }
                            else 
                            {
                                <button type="button" class="delete-btn cursor-none" >
                                    <a class="cursor-none"> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image cursor-none" alt=""></a>
                                </button>
                            }
                        </div>
                        <div class="d-flex flex-column mt-2 mt-sm-3 mt-md-5">
                            @foreach (var modifierGroup in @Model.ModifierGroups)
                            {
                                var divCustomId = "modifierGroup" + modifierGroup.Id;
                                <div onclick="changeModifiers(@modifierGroup.Id)"
                                    class="d-flex justify-content-between align-items-center cursor-pointer p-1">
                                    <div>
                                        <img src="~/images/icons/gray-six-dots.svg" id="sandwich-black-dots"
                                            class="small-image " alt="">
                                        <img src="~/images/icons/blue-six-dots.svg" id="sandwich-blue-dots d-none"
                                            class="small-image" alt="">
                                        <span class="menu-category-navigation-items" id="sandwich-span">@modifierGroup.Name</span>
                                    </div>
                                    <div>
                                        @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
                                        {
                                            <button type="button" class="delete-btn bg-white">
                                                <a> <img src="~/images/icons/edit.svg" class="small-image " alt="" onclick="editModifierGroup(@modifierGroup.Id)"></a>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="delete-btn bg-white cursor-none">
                                                <a class="cursor-none"> <img src="~/images/icons/edit.svg" class="small-image cursor-none" alt=""></a>
                                            </button>
                                        }
                                        @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanDelete == true))
                                        {
                                            <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                                                data-bs-target="#deleteModifierGroup" onclick="deleteModifierGroupFunc(@modifierGroup.Id)">
                                                <a> <img src="~/images/icons/delete.svg" class="small-image" alt="" id="delete-icon"></a>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="delete-btn bg-white cursor-none">
                                                <a class="cursor-none"> <img src="~/images/icons/delete.svg" class="small-image cursor-none" alt="" id="delete-icon"></a>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<input type="hidden" id="modifierGroupId21" value="@Model.ModifierGroups[0].Id"/>
<div class="col-12 col-md-8 col-lg-9">
    <div class="d-flex menu-mobile-header-div justify-content-between pt-3 pt-sm-2 align-items-center">
