@* add new modifier modal *@
<div class="modal fade" id="AddModifierModal" data-bs-backdrop="static" data-bs-keyboard="false"
    tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-add-modifier-group modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="AddModifierModalTitle">Add New Modifier
                </h5>
                <button onclick="clearAddModifierModal()" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <div class="modal-body">

                <div class="row align-items-center">
                    <div class="col-12  row">
                        <div class="dropdown dropdown-multiselect col-12 col-md-6 p-2">
                            <button
                                class="btn btn-outline-primary dropdown-toggle d-flex justify-content-between align-items-center"
                                type="button" id="custom-multiselect" data-bs-toggle="dropdown"
                                aria-expanded="false">
                                <span>Select Modifier Group(s)</span>
                                <span class="ms-auto dropdown-arrow"></span>
                            </button>
                            <ul class="dropdown-menu p-2" aria-labelledby="custom-multiselect" style="width: 98%;">
                                @foreach (var modifierGroup in Model.ModifierGroups)
                                {
                                    var customId = "AddModifier" + modifierGroup.Id;
                                    <li>
                                        <input onchange="addModifierGroupToModifier(id)" type="checkbox" style="height:1em;"
                                            class="form-check-input multi-checkbox"
                                            value="@modifierGroup.Id" id="@customId">
                                        <label class="form-check-label" for="@customId">@modifierGroup.Name</label>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="col-12 col-md-6 form-floating">
                            @if(Model.AddModifierViewModel !=null && Model.AddModifierViewModel.Name != null)
                            {
                                <input asp-for="@Model.AddModifierViewModel.Name" type="text"
                                    class="form-control" name="AddModifierViewModel.Name" 
                                    value="@Model.AddModifierViewModel.Name"
                                    id="AddModifierName21" required placeholder="name">
                            }
                            else
                            {
                                <input asp-for="@Model.AddModifierViewModel.Name" type="text"
                                    class="form-control" name="AddModifierViewModel.Name"
                                    id="AddModifierName21" required placeholder="name">
                            }
                            <span id="AddModifierNameError" asp-validation-for="@Model.AddModifierViewModel.Name" class="text-danger"></span>
                            <label for="AddModifierName21" class="">Name*</label>
                        </div>
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="col-12  row">
                        <div class="form-floating pe-2 my-auto col-12 col-md-4">
                            @if(Model.AddModifierViewModel !=null && Model.AddModifierViewModel.Rate != null)
                            {
                                <input asp-for="@Model.AddModifierViewModel.Rate" type="number"
                                    class="form-control" name="Model.AddModifierViewModel.Rate"
                                    value="@Model.AddModifierViewModel.Rate"
                                    id="AddModifierRate" required placeholder="name">
                            }
                            else
                            {
                                <input asp-for="@Model.AddModifierViewModel.Rate" type="number"
                                    class="form-control" name="Model.AddModifierViewModel.Rate"
                                    id="AddModifierRate" required placeholder="name">
                            }
                            <label for="AddModifierRate" class="">Rate*</label>
                            <span id="AddModifierRateError" asp-validation-for="@Model.AddModifierViewModel.Rate" class="text-danger"></span>
                        </div>
                        <div class="form-floating pe-2 my-auto col-12 col-md-4">
                            @if(Model.AddModifierViewModel !=null && Model.AddModifierViewModel.Quantity != null)
                            {
                                <input asp-for="@Model.AddModifierViewModel.Quantity" type="text"
                                    class="form-control" name="Model.AddModifierViewModel.Quantity"
                                    value="@Model.AddModifierViewModel.Quantity"
                                    id="AddModifierQuantity" required placeholder="name">
                            }
                            else
                            {
                                <input asp-for="@Model.AddModifierViewModel.Quantity" type="text"
                                    class="form-control" name="Model.AddModifierViewModel.Quantity"
                                    id="AddModifierQuantity" required placeholder="name">
                            }
                            <label for="AddModifierQuantity" class="">Quantity</label>
                            <span id="AddModifierQuantityError" asp-validation-for="@Model.AddModifierViewModel.Quantity" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4 p-2 form-floating">
                            <select asp-for="@Model.AddModifierViewModel.Unit"
                                name="Model.AddModifierViewModel.Unit" id="AddModifierUnit"
                                class="form-select" aria-label="Select Country">
                                <option value="pcs">Pcs</option>
                                <option value="plate">Plate</option>
                                <option value="gm">Gm</option>
                                <option value="ml">Ml</option>
                            </select>
                            <label for="select-country" class="mx-2 mt-2">Unit*</label>
                        </div>
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="col-12  row">
                        <div class="form-floating my-auto col-12 pt-2">
                            @if(Model.AddModifierViewModel !=null && Model.AddModifierViewModel.Description != null)
                            {
                                <input asp-for="@Model.AddModifierViewModel.Description" type="text"
                                    class="form-control" name="Model.AddModifierViewModel.Description"
                                    value="@Model.AddModifierViewModel.Description"
                                    id="AddModifierDescription21" placeholder="name">
                            }
                            else
                            {
                                <input asp-for="@Model.AddModifierViewModel.Description" type="text"
                                    class="form-control" name="Model.AddModifierViewModel.Description"
                                    id="AddModifierDescription21" placeholder="name">
                            }
                            <label for="AddModifierDescription21" class="">Description</label>
                        </div>
                    </div>
                </div>
                <input type="hidden" id="AddModifierModifierGroupIds"
                    asp-for="@Model.AddModifierViewModel.ModifierGroupIds"
                    name="Model.AddModifierViewModel.ModifierGroupIds" />
                @if(Model.AddModifierViewModel != null && Model.AddModifierViewModel.Id != 0)
                {
                    <input type="hidden" id="AddModifierId" asp-for="@Model.AddModifierViewModel.Id"
                        name="Model.AddModifierViewModel.Id" value="@Model.AddModifierViewModel.Id" />
                }
                else
                {
                    <input type="hidden" id="AddModifierId" asp-for="@Model.AddModifierViewModel.Id"
                        name="Model.AddModifierViewModel.Id" value="-1" />
                }
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <button type="submit" onclick="addModifier()" id="AddModifierButton" class="btn btn-primary px-3">Save</button>
                <a onclick="clearAddModifierModal()"><button type="button"
                        class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>



<script>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

    var deleteModifierList = [];

   

    $(document).ready(function () {
        $("#AddModifierName21").on("input", function () {
            if ($("#AddModifierName21").val().length <= 0) {
                $("#AddModifierNameError").text("Modifier's name is required.")
            } else {
                $("#AddModifierNameError").text("")
            }
        });

        $("#AddModifierRate").on("input", function () {
            if ($("#AddModifierRate").val().length <= 0) {
                $("#AddModifierRateError").text("Modifier's rate is required.")
            } else if (/^(0|[1-9]\d*)(\.\d+)?$/.test($("#AddModifierRate").val()) == false) {
                $("#AddModifierRateError").text("Rate must be a number.")
            } else {
                $("#AddModifierRateError").text("")
            }
        });

        $("#AddModifierQuantity").on("input", function () {
            if ($("#AddModifierQuantity").val().length <= 0) {
                $("#AddModifierQuantityError").text("Modifier's quantity is required.")
            } else if (/^[0-9]+$/.test($("#AddModifierQuantity").val()) == false) {
                $("#AddModifierQuantityError").text("Quantity must be a number.")
            } else {
                $("#AddModifierQuantityError").text("")
            }
        });
    });


    function addModigierGroupFunc() {
        $("#AddModifierButton2").click(function () {
            var name = $("#AddModifierName").val();
            if (name.length <= 0) {
                $("#addMGName").text("Modifier Group's name is required.")
                return;
            }
            var description = $("#AddModifierDescription").val();
            var modifierIds = selectedModifiers.map(x => x.id);
            var modifierGroupId = $("#ModifierGroupId").val();
            $.ajax({
                url: '@Url.Action("AddModifierGroup", "Menu")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ ModifierGroupName: name, ModifierGroupDescription: description, SelectedModifierIds: modifierIds, ModifierGroupId: modifierGroupId }),
                success: function (data) {
                    if (data.success) {
                        toastr.success(data.message);
                        $("#AddModifierGroupModal").modal("hide");
                        $("#addModifierGroupModalTitle").text("Add Modifier Group");
                        $.ajax({
                            type: "GET",
                            url: "/Menu/RefreshModifiersPartial",
                            success: function (data) {
                                $("#modifiers-content").html(data);
                                selectedModifiers = [];
                                $("#AddModifierName").val("");
                                $("#AddModifierDescription").val("");
                                $("#ModifierGroupId").val("-1");
                            },
                            error: function (data) {
                                console.log(data);
                            }
                        });
                    } else {
                        toastr.error(data.message);
                    }
                }
            });
        });
    }

    function deleteModifierGroupFunc (modifierId) {
        $("#deleteModifierGroupButton").click(function () {
            $.ajax({
                url: '@Url.Action("DeleteModifierGroup", "Menu")',
                type: 'DELETE',
                data: { modifierGroupId: modifierId },
                success: function (data) {
                    if (data.success) {
                        toastr.success(data.message);
                        $("#deleteModifierGroup").modal("hide");
                        $.ajax({
                            type: "GET",
                            url: "/Menu/RefreshModifiersPartial",
                            success: function (data) {
                                $("#modifiers-content").html(data);
                            },
                            error: function (data) {
                                console.log(data);
                            }
                        });
                    } else {
                        toastr.error(data.message);
                    }
                }
            });
        });
    }

    var selectedModifiersGroupsAddModifier = [];
    if (selectedModifiersGroupsAddModifier2) {
        selectedModifiersGroupsAddModifier = selectedModifiersGroupsAddModifier2;
    }

    function addModifierGroupToModifier(id) {
        var modifierGroupId = id.replace("AddModifier", "");
        modifierGroupId = parseInt(modifierGroupId);
        if (selectedModifiersGroupsAddModifier.includes(modifierGroupId)) {
            selectedModifiersGroupsAddModifier = selectedModifiersGroupsAddModifier.filter(x => x !== modifierGroupId);
            $("#AddModifierModifierGroupIds").val(selectedModifiersGroupsAddModifier);
        } else {
            selectedModifiersGroupsAddModifier.push(modifierGroupId);
            $("#AddModifierModifierGroupIds").val(selectedModifiersGroupsAddModifier);
        }
    }

    $(document).ready(function () {
        $("#AddModifierName21").on("input", function () {
            if ($("#AddModifierName21").val().length <= 0) {
                $("#AddModifierNameError").text("Modifier's name is required.")
            } else {
                $("#AddModifierNameError").text("")
            }
        });

        $("#AddModifierRate").on("input", function () {
            if ($("#AddModifierRate").val().length <= 0) {
                $("#AddModifierRateError").text("Modifier's rate is required.")
            } else if (/^(0|[1-9]\d*)(\.\d+)?$/.test($("#AddModifierRate").val()) == false) {
                $("#AddModifierRateError").text("Rate must be a number.")
            } else {
                $("#AddModifierRateError").text("")
            }
        });

        $("#AddModifierQuantity").on("input", function () {
            if ($("#AddModifierQuantity").val().length <= 0) {
                $("#AddModifierQuantityError").text("Modifier's quantity is required.")
            } else if (!/^[0-9]+$/.test($("#AddModifierQuantity").val()) == false) {
                $("#AddModifierQuantityError").text("Quantity must be a number.")
            } else {
                $("#AddModifierQuantityError").text("")
            }
        });
    });

    function addModifier() {
        var name = $("#AddModifierName21").val();
        if (name.length <= 0) {
            $("#AddModifierNameError").text("Modifier's name is required.")
            return;
        }
        var rate = $("#AddModifierRate").val();
        if (rate.length <= 0) {
            $("#AddModifierRateError").text("Modifier's rate is required.")
            return;
        }
        var quantity = $("#AddModifierQuantity").val();
        if (quantity.length <= 0) {
            $("#AddModifierQuantityError").text("Modifier's quantity is required.")
            return;
        }
        var unit = $("#AddModifierUnit").val();
        var description = $("#AddModifierDescription21").val();
        var id = $("#AddModifierId").val();
        var modifierGroupIds = selectedModifiersGroupsAddModifier;
        console.log(id);
        $.ajax({
            url: '@Url.Action("AddModifier", "Menu")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ Name: name, Rate: rate, Quantity: quantity, Unit: unit, Description: description, ModifierGroupIds: modifierGroupIds, Id: id }),
            success: function (data) {
                if (data.success) {
                    toastr.success(data.message);
                    $("#AddModifierModal").modal("hide");
                    $.ajax({
                        url: '@Url.Action("ModifiersFilter", "Menu")',
                        type: 'GET',
                        data: { pageIndex: 1, pageSize: 5, modifierGroupId: $("#modifierGroupId21").val() },
                        success: function (data) {
                            $("#ModifiersTablePartial").html(data);
                            clearAddModifierModal()
                            $("#AddModifierModal").modal("hide");
                        }
                    });
                } else {
                    toastr.error(data.message);
                }
            }
        });
    }

    function editModifierGroup(modifierGroupId) {
        $.ajax({
            url: '@Url.Action("EditModifierGroup", "Menu")',
            type: 'GET',
            data: { modifierGroupId: modifierGroupId },
            success: function (data) {
                $("#modifiers-content").html(data);
                $("#AddModifierGroupModal").modal("show");
                $("#addModifierGroupModalTitle").text("Edit Modifier Group");
                addModigierGroupFunc();
            },
            error: function (error) {
                console.log(error);
            }
        });
    }

    $(document).ready(function () {
        $(".multi-checkbox").change(function () {
            var selected = [];
            $(".multi-checkbox:checked").each(function () {
                selected.push($(this).next("label").text());
            });

            if (selected.length > 0) {
                $("#custom-multiselect span:first-child").text(selected.join(", "));
            } else {
                $("#custom-multiselect span:first-child").text("Select Categories");
            }
        });
    });

    function editModifier(modifierId) {
        var modifierGroupId = $("#modifierGroupId21").val();
        console.log(modifierGroupId);
        $.ajax({
            url: '@Url.Action("EditModifier", "Menu")',
            type: 'GET',
            data: { modifierId: modifierId, modifierGroupId: modifierGroupId },
            success: function (data) {
                $("#modifiers-content").html(data);
                $("#AddModifierModalTitle").text("Edit Modifier");
                $("#AddModifierModal").modal('show');
                $("#modifierGroupId21").val(modifierGroupId);
            },
            error: function (error) {
                console.log(error);
            }
        });
    }

    function clearSelectedModifiersList() {
        selectedModifiers = [];
        $("#modifiersSelected").html("");
        $("#AddModifierName").val("");
        $("#AddModifierDescription").val("");
        $("#ModifierGroupId").val("-1");
        $("#addModifierGroupModalTitle").text("Add Modifier Group");
    }

    function clearAddModifierModal() {
        $("#AddModifierModal").modal("hide");
        $("#AddModifierModalTitle").text("Add New Modifier");
        $("#AddModifierName21").val("");
        $("#AddModifierRate").val("");
        $("#AddModifierQuantity").val("");
        $("#AddModifierUnit").val("");
        $("#AddModifierDescription21").val("");
        selectedModifiersGroupsAddModifier.forEach(x => {
            var customId = "AddModifier" + x;
            $("#" + customId).prop("checked", false);
        });
        selectedModifiersGroupsAddModifier = [];
        $("#AddModifierModifierGroupIds").val("");
        $("#AddModifierId").val("-1");
    }

</script>