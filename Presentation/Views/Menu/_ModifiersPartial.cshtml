@using DAL.ViewModels
@model DAL.ViewModels.MenuViewModel
@{
    var permissionList = new List<PermissionModel>();

    if (Context.Session.Get("permissions") != null)
    {
        permissionList = System.Text.Json.JsonSerializer.Deserialize<List<PermissionModel>>(Context.Session.Get("permissions"));
    }

}

<div class="d-none d-md-block col-md-4 col-lg-3 col-xxl-2 bg-menu-category height-main-container">
    <div class="d-flex justify-content-between p-3">
        <h4 class="font-blue">Modifiers</h4>
        @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
        {
            <button type="button" class="delete-btn" onclick="openAddModifierGroupModal()">
                <a> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image" alt=""></a>
            </button>
        } 
    </div>
    <div class="d-flex flex-column  category-list-styles">
        @foreach (var modifierGroup in Model.ModifierGroups)
        {
            var divCustomIdModifier = "modifierGroup" + modifierGroup.Id;
            var divCustomIdModifier2 = "modifierGroup" + modifierGroup.Id + "two";
            var divCustomIdModifier4 = "modifierGroup" + modifierGroup.Id + "four";
            var bluedotModifier = "blue-dot" + modifierGroup.Id;
            var graydotModifier = "gray-dot" + modifierGroup.Id;

            @if (Model.ModifierGroups[0].Id == modifierGroup.Id)    
            {
                <div onmouseenter="showDivM(@divCustomIdModifier)" onmouseleave="hideDivM(@divCustomIdModifier)" onclick="changeModifiers(@modifierGroup.Id)" id="@divCustomIdModifier2"
                    class="d-flex justify-content-between align-items-center cursor-pointer p-2">
                    <div>
                        <img src="~/images/icons/gray-six-dots.svg" id="@graydotModifier" class="small-image d-none gray-dot" alt="">
                        <img src="~/images/icons/blue-six-dots.svg" id="@bluedotModifier" class="small-image blue-dot" alt="">
                        <span class="menu-category-navigation-items-modifier active-nav-item" id="@divCustomIdModifier4">@modifierGroup.Name</span>
                    </div>
                    <div id="@divCustomIdModifier" class="d-none">
                        @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
                        {
                            <button type="button" class="delete-btn bg-white">
                                <a> <img src="~/images/icons/edit.svg" class="small-image " alt="" onclick="editModifierGroup(@modifierGroup.Id)"></a>
                            </button>
                        }
                        @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanDelete == true))
                        {
                            <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                                data-bs-target="#deleteModifierGroup" onclick="deleteModifierGroupFunc(@modifierGroup.Id)">
                                <a> <img src="~/images/icons/delete.svg" class="small-image" alt="" id="delete-icon"></a>
                            </button>
                        }
                    </div>
                </div>               
            } 
            else
            {
                <div onmouseenter="showDivM(@divCustomIdModifier)" onmouseleave="hideDivM(@divCustomIdModifier)" onclick="changeModifiers(@modifierGroup.Id)" id="@divCustomIdModifier2"
                    class="d-flex justify-content-between align-items-center cursor-pointer p-2">
                    <div>
                        <img src="~/images/icons/gray-six-dots.svg" id="@graydotModifier" class="small-image gray-dot" alt="">
                        <img src="~/images/icons/blue-six-dots.svg" id="@bluedotModifier" class="small-image d-none blue-dot" alt="">
                        <span class="menu-category-navigation-items-modifier" id="@divCustomIdModifier4">@modifierGroup.Name</span>
                    </div>
                    <div id="@divCustomIdModifier" class="d-none">
                        @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
                        {
                            <button type="button" class="delete-btn bg-white">
                                <a> <img src="~/images/icons/edit.svg" class="small-image " alt="" onclick="editModifierGroup(@modifierGroup.Id)"></a>
                            </button>
                        }
                        @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanDelete == true))
                        {
                            <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                                data-bs-target="#deleteModifierGroup" onclick="deleteModifierGroupFunc(@modifierGroup.Id)">
                                <a> <img src="~/images/icons/delete.svg" class="small-image" alt="" id="delete-icon"></a>
                            </button>
                        }
                    </div>
                </div>            
            }
        }
    </div>
</div>
<div class="accordion col-12 d-block d-md-none" id="accordionExample">
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingOne">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne"> Modifiers
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne"
                data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    <div class="d-block d-lg-none p-3 col-lg-3 bg-menu-category">
                        <div class="d-flex justify-content-between">
                            <h4 class="font-blue">Modifier Group</h4>
                            @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
                            {
                                <button type="button" class="delete-btn" onclick="openAddModifierGroupModal()" data-bs-toggle="modal" data-bs-target="#AddModifierGroupModal">
                                    <a> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image" alt=""></a>
                                </button>
                            }
                        </div>
                        <div class="d-flex flex-column mt-2 mt-sm-3 mt-md-5">
                            @foreach (var modifierGroup in @Model.ModifierGroups)
                            {
                                var divCustomId = "modifierGroup" + modifierGroup.Id;
                                <div onclick="changeModifiers(@modifierGroup.Id)"
                                    class="d-flex justify-content-between align-items-center cursor-pointer p-1">
                                    <div>
                                        <img src="~/images/icons/gray-six-dots.svg" id="sandwich-black-dots"
                                            class="small-image " alt="">
                                        <img src="~/images/icons/blue-six-dots.svg" id="sandwich-blue-dots d-none" style="display: none;"
                                            class="small-image" alt="">
                                        <span class="menu-category-navigation-items" id="sandwich-span">@modifierGroup.Name</span>
                                    </div>
                                    <div>
                                        @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
                                        {
                                            <button type="button" class="delete-btn bg-white">
                                                <a> <img src="~/images/icons/edit.svg" class="small-image " alt="" onclick="editModifierGroup(@modifierGroup.Id)"></a>
                                            </button>
                                        }
                                        @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanDelete == true))
                                        {
                                            <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                                                data-bs-target="#deleteModifierGroup" onclick="deleteModifierGroupFunc(@modifierGroup.Id)">
                                                <a> <img src="~/images/icons/delete.svg" class="small-image" alt="" id="delete-icon"></a>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<input type="hidden" id="modifierGroupId21" value="@Model.ModifierGroups[0].Id"/>
<div class="col-12 col-md-8 col-lg-9">
    <div class="d-flex menu-mobile-header-div justify-content-between pt-3 pt-sm-2 align-items-center">
        <h4 class="px-sm-4 py-2">Modifiers</h4>
        <div class="d-flex justify-content-center gap-2 align-items-center mx-3">
            <div class="input-group search-box d-none d-md-block">
                <input type="text" id="searchInputModifier" class="form-control search-input py-1 py-sm-2"
                    placeholder="Search">
                <img src="~/images/icons/search-icon.svg" class="small-image anchor-tag  search-icon" alt="">
            </div>
            <p class="delete-styles d-none" id="search-icon-modifier" onclick="showSearchBarModifier()">
                <a class="text-decoration-none text-black add-user-link">
                    <img src="~/images/icons/search-header.svg" class="p-2 menu-category-image-delete" alt="">
                </a>
            </p>
            <div id="mobile-search-bar-modifier" class="input-group search-box d-none d-md-none">
                <input id="searchInputModifierMobile" type="text" class="form-control search-input py-1 py-sm-2"
                    placeholder="Search">
                <img src="~/images/icons/search-icon.svg" class="small-image anchor-tag  search-icon" alt="">
            </div>
            @if(permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanDelete == true))
            {
                <p class="delete-styles " data-bs-toggle="modal" data-bs-target="#deleteModifiers" id="deleteSelectedModifiersButton">
                    <a class="text-decoration-none text-black cursor-pointer add-user-link">
                        <img src="~/images/icons/delete-header.svg" class="p-2  menu-category-image-delete" alt="">
                    </a>
                </p>
            }
            @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
            {
                <p class="delete-styles d-block d-md-none d-flex justify-content-center align-items-center"
                     style="width: 49px; height: 49px;">
                    <button onclick="openAddModifierModal()" class="text-decoration-none text-black btn  add-user-link">
                        <img src="~/images/icons/plus-header.svg" class="p-2 menu-category-image-delete" alt="">
                    </button>
                </p>
                <button onclick="openAddModifierModal()" id="addModifierModal"
                    class="d-none d-md-block button-styles-header w-100 add-item-button">
                    <a class="text-decoration-none text-white add-user-link gap-2 d-flex justify-content-center">
                        <p>+</p>
                        <p class="d-none d-sm-block">Add Modifier</p>
                    </a>
                </button>
            }
        </div>
    </div>

    <div class="table-responsive col-12 form-bg mx-4 p-3 mb-3 mx-auto">


        <div id="ModifiersTablePartial" class="">


            <partial name="_ModifiersTable" model="@Model" />

        </div>
    </div>

@* delete modifiergroup modal *@
    <div class="modal fade" id="deleteModifierGroup" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel1">Delete Confirmation
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex align-items-center flex-column">
                    <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                    <p>Are you sure you want to delete this modifier group?</p>
                </div>
                <div class="modal-footer d-flex justify-content-center">
                    <button id="deleteModifierGroupButton" type="button" class="btn btn-primary px-3"
                        data-bs-dismiss="modal">Yes</button>
                    <a data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">Cancel</button></a>
                </div>
            </div>
        </div>
    </div>

@* add modifier group modal *@
    <div class="modal fade" id="AddModifierGroupModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-add-modifier-group modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addModifierGroupModalTitle">Add Modifier Group</h5>
                    <button onclick="clearSelectedModifiersList()" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="">
                        <div class="row">
                            <div class="col-12">
                                <div class="form-floating my-auto">
                                    <input type="text" asp-for="@Model.CreateModifierGroupViewModel.ModifierGroupName"
                                        class="form-control" name="CreateModifierGroupViewModel.ModifierGroupName"
                                        id="AddModifierName" required placeholder="name">
                                    <label for="category-name" class="">Name*</label>
                                    <span id="addMGName" asp-validation-for="@Model.CreateModifierGroupViewModel.ModifierGroupName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 mt-2 mb-3">
                                <div class="form-floating my-auto">
                                    <input type="text"
                                        asp-for="@Model.CreateModifierGroupViewModel.ModifierGroupDescription"
                                        class="form-control"
                                        name="CreateModifierGroupViewModel.ModifierGroupDescription"
                                        id="AddModifierDescription" required placeholder="Description*">
                                    <label for="category-description" class="">Description*</label>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" id="ModifierIdsAddModifierGroup"
                            asp-for="@Model.CreateModifierGroupViewModel.SelectedModifierIds"
                            name="CreateModifierGroupViewModel.SelectedModifierIds" />
                        @if (Model.CreateModifierGroupViewModel != null && Model.CreateModifierGroupViewModel.ModifierGroupId != 0)
                        {
                            <input type="hidden" id="ModifierGroupId"
                                asp-for="@Model.CreateModifierGroupViewModel.ModifierGroupId"
                                name="CreateModifierGroupViewModel.ModifierGroupId"
                                value="@Model.CreateModifierGroupViewModel.ModifierGroupId" />
                        }
                        else
                        {
                            <input type="hidden" id="ModifierGroupId"
                                asp-for="@Model.CreateModifierGroupViewModel.ModifierGroupId"
                                name="CreateModifierGroupViewModel.ModifierGroupId" value="-1"/>
                        }
                        <a onclick="openModalAllModifiers()" class="text-decoration-none cursor-pointer">+ Add Existing
                            Modifiers</a>
                        <div id="modifiersSelected" class="d-flex flex-wrap mt-2 ">
                            @if (Model.CreateModifierGroupViewModel != null && Model.CreateModifierGroupViewModel.SelectedModifierIds != null)
                            {
                                foreach (var modifier in Model.CreateModifierGroupViewModel.Modifiers)
                                {
                                    <script>
                                        addTagCustom(@modifier.Id, '@modifier.Name');
                                        selectedModifiers.push({
                                            id: @modifier.Id,
                                            name: '@modifier.Name'
                                        });
                                    </script>
                                }
                            }
                        </div>
                <div class="modal-footer d-flex justify-content-end">
                    <button type="button" id="AddModifierButton2" class="btn btn-primary px-3" >Save</button>
                    <a data-bs-dismiss="modal" onclick="clearSelectedModifiersList()"><button type="button" class="btn btn-contrast px-3">Cancel</button></a>
                </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

@* delete modififers modal *@
<div class="modal fade" id="deleteModifiers" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete
                    Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column align-items-center justify-content-center">
                <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete these modifiers?</p>
            </div>
            <div class="modal-footer">
                <button id="deleteModifierButton" onclick="deleteSelectedModifiers()" type="button" class="btn btn-primary px-3" data-bs-dismiss="modal">Yes</button>
                <a data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">No</button></a>
            </div>
        </div>
    </div>
</div>

@* add modifier group modal 2 *@
<div class="modal fade" id="AddModifierGroupModal2" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-add-modifier-group modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Select Existing Modifier(s)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-6">
                        <div class="input-group search-box">
                            <input id="searchInputAllModifiers" type="text"
                                class="form-control search-input py-1 py-sm-2" placeholder="Search">
                            <img src="./images/icons/search-icon.svg" class="small-image anchor-tag  search-icon"
                                alt="">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <div class="table-responsive col-12 form-bg mx-4  mx-auto">
                            <div id="allModifiersPartial">
                                <partial name="_AllModifiersPartial" model="@Model" />
                            </div>
                        </div>
                        <div class="modal-footer d-flex justify-content-end">
                            <button onclick="addModalsToList()" type="button" class="btn btn-primary px-3"
                                data-bs-dismiss="modal">Save</button>
                            <a data-bs-dismiss="modal"><button type="button"
                                    class="btn btn-contrast px-3">Cancel</button></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="addEditModifierModal">
    <partial name="_AddEditModifierPartial" model="@Model" />
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


<script>
    var deleteModifierList = [];
</script>
<script src="~/js/menuModifiers.js" asp-append-version="true"></script>