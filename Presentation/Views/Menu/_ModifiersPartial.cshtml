            else {
                <p class="delete-styles cursor-none" id="deleteSelectedModifiersButton">
                    <a class="text-decoration-none text-black cursor-none">
                        <img src="~/images/icons/delete-header.svg" class="p-2  menu-category-image-delete cursor-none" alt="">
                    </a>
                </p>
            }
            @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
