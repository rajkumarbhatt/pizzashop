@using DAL.ViewModels
@model DAL.ViewModels.MenuViewModel
@{
    var permissionList = new List<PermissionModel>();

    if (Context.Session.Get("permissions") != null)
    {
        permissionList = System.Text.Json.JsonSerializer.Deserialize<List<PermissionModel>>(Context.Session.Get("permissions"));
    }

}
<input class="d-none" id="categoryId" value="@Model.Categories[0].Id" />
<div id="items-content" class=" form-bg p-2 my-1 row mx-4 ">
    <div class="d-none d-md-block col-md-4 col-lg-3 col-xxl-2 bg-menu-category height-main-container">
        <div class="d-flex justify-content-between p-3">
            <h4 class="font-blue">Category</h4>
            @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
            {
                <button type="button" class="delete-btn" data-bs-toggle="modal" data-bs-target="#categoryModal">
                    <a> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image" alt=""></a>
                </button>
            }
            else
            {
                <button type="button" class="delete-btn cursor-none" data-bs-toggle="modal" data-bs-target="#categoryModal"
                    disabled>
                    <a> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image cursor-none" alt=""></a>
                </button>
            }
        </div>
        <div class="d-flex flex-column  category-list-styles ">
            @foreach (var category in Model.Categories)
            {
                var divCustomId = "div" + category.Id;
                var divCustomId2 = "div" + category.Id + "2";
                var divCustomId3 = "div" + category.Id + "3";
                var divCustomId4 = "div" + category.Id + "4";
                var blueDotId = "blueDot" + category.Id;
                var grayDotId = "grayDot" + category.Id;
                <div onmouseenter="showDiv(@divCustomId)" onmouseleave="hideDiv(@divCustomId)"
                    onclick="changeItems(@category.Id)" id="@divCustomId2"
                    class="d-flex justify-content-between align-items-center cursor-pointer p-2" >
                    <div>
                        <img src="~/images/icons/gray-six-dots.svg" id="@grayDotId" class="small-image gray-dot" alt="">
                        <img src="~/images/icons/blue-six-dots.svg" id="@blueDotId" class="small-image blue-dot d-none" alt="">
                        <span class="menu-category-navigation-items" id="@divCustomId4">@category.Name</span>
                    </div>
                    <div id="@divCustomId" class="d-none">
                        @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
                        {
                            <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                                data-bs-target="#editCategoryModal">
                                <a> <img src="~/images/icons/edit.svg" class="small-image " alt=""
                                        onclick="editCategory('@category.Id', '@category.Name', '@category.Description')"></a>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="delete-btn bg-white cursor-none" data-bs-toggle="modal"
                                data-bs-target="#editCategoryModal" disabled>
                                <a> <img src="~/images/icons/edit.svg" class="small-image cursor-none" alt=""
                                        onclick="editCategory('@category.Id', '@category.Name', '@category.Description')"></a>
                            </button>
                        }
                        @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanDelete == true))
                        {
                            <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                                data-bs-target="#categoryDeleteModal" onclick="openModal('@category.Id')">
                                <a> <img src="~/images/icons/delete.svg" class="small-image" alt=""
                                        id="sandwich-delete-icon"></a>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="delete-btn bg-white cursor-none" data-bs-toggle="modal"
                                data-bs-target="#categoryDeleteModal" disabled>
                                <a> <img src="~/images/icons/delete.svg" class="small-image cursor-none" alt=""
                                        id="sandwich-delete-icon"></a>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="accordion col-12 d-block d-md-none" id="accordionExample">
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingOne">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne"> Items
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne"
                data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    <div class="d-block d-lg-none p-3 col-lg-3 bg-menu-category">
                        <div class="d-flex justify-content-between">
                            <h4 class="font-blue">Category</h4>
                            @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit ==
                                                        true))
                            {
                                <button type="button" class="delete-btn" data-bs-toggle="modal"
                                    data-bs-target="#categoryModal">
                                    <a> <img src="~/images/icons/plus-with-border.svg" class="menu-category-image"
                                            alt=""></a>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="delete-btn cursor-none" data-bs-toggle="modal"
                                    data-bs-target="#categoryModal" disabled>
                                    <a> <img src="~/images/icons/plus-with-border.svg"
                                            class="menu-category-image cursor-none" alt=""></a>
                                </button>
                            }
                            <div class="modal fade" id="categoryModalMobile" data-bs-backdrop="static"
                                data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel"
                                aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="staticBackdropLabel">Add Category
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="form-floating mb-3">
                                                <input type="text" class="form-control" name="category-name"
                                                    id="category-name" required placeholder="name">
                                                <label for="category-name" class="">Name</label>
                                            </div>
                                            <div class="form-floating">
                                                <input type="text" class="form-control" name="category-description"
                                                    id="category-description" required
                                                    placeholder="category-description">
                                                <label for="category-description" class="">Description</label>
                                            </div>
                                        </div>
                                        <div class="modal-footer d-flex justify-content-end">
                                            <button type="button" class="btn btn-primary px-3"
                                                data-bs-dismiss="modal">Save</button>
                                            <a href="./menu.html"><button type="button"
                                                    class="btn btn-contrast px-3">Cancel</button></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex flex-column gap-2 mt-2 mt-sm-3 mt-md-5">
                            @foreach (var category in Model.Categories)
                            {
                                <div onclick="changeItems(@category.Id)"
                                    class="cursor-pointer d-flex justify-content-between align-items-center">
                                    <div>
                                        <img src="~/images/icons/gray-six-dots.svg" id="sandwich-black-dots"
                                            class="small-image " alt="">
                                        <img src="~/images/icons/blue-six-dots.svg" id="sandwich-blue-dots"
                                            class="small-image d-none" alt="">
                                        <span class="menu-category-navigation-items"
                                            id="sandwich-span">@category.Name</span>
                                    </div>
                                    <div>
                                        @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit
                                                                            == true))
                                        {
                                            <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                                                data-bs-target="#editCategoryModal">
                                                <a> <img src="~/images/icons/edit.svg" class="small-image " alt=""
                                                        onclick="editCategory('@category.Id', '@category.Name', '@category.Description')"></a>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="delete-btn bg-white cursor-none" data-bs-toggle="modal"
                                                data-bs-target="#editCategoryModal" disabled>
                                                <a> <img src="~/images/icons/edit.svg" class="small-image cursor-none" alt=""
                                                        onclick="editCategory('@category.Id', '@category.Name', '@category.Description')"></a>
                                            </button>
                                        }
                                        @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" &&
                                                                            p.CanDelete == true))
                                        {
                                            <button type="button" class="delete-btn bg-white" data-bs-toggle="modal"
                                                data-bs-target="#categoryDeleteModal" onclick="openModal('@category.Id')">
                                                <a> <img src="~/images/icons/delete.svg" class="small-image" alt=""
                                                        id="sandwich-delete-icon"></a>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="delete-btn bg-white cursor-none" data-bs-toggle="modal"
                                                data-bs-target="#categoryDeleteModal" disabled>
                                                <a> <img src="~/images/icons/delete.svg" class="small-image cursor-none" alt=""
                                                        id="sandwich-delete-icon"></a>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-8 col-lg-9">
        <div class="d-flex menu-mobile-header-div justify-content-between pt-3 pt-sm-2 align-items-center">
            <h4 class="px-sm-4 py-2">Items</h4>
            <div class="d-flex justify-content-center gap-2 align-items-center mx-3">
                <div class="input-group search-box d-none d-md-block">
                    <input type="text" id="searchInput" onchange="" class="form-control search-input py-1 py-sm-2"
                        placeholder="Search">
                    <img src="~/images/icons/search-icon.svg" class="small-image anchor-tag  search-icon" alt="">
                </div>
                <p class="delete-styles d-bloack d-md-none" id="search-icon" onclick="showSearchBar()">
                    <a class="text-decoration-none text-black add-user-link">
                        <img src="~/images/icons/search-header.svg" class="p-2 menu-category-image-delete" alt="">
                    </a>
                </p>
                <div id="mobile-search-bar" class="input-group search-box d-none d-md-none">
                    <input id="searchInput2" type="text" class="form-control search-input py-1 py-sm-2"
                        placeholder="Search">
                    <img src="~/images/icons/search-icon.svg" class="small-image anchor-tag  search-icon" alt="">
                </div>
                @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanDelete == true))
                {
                    <p class="delete-styles" data-bs-toggle="modal" data-bs-target="#deleteItems">
                        <a class="text-decoration-none text-black   add-user-link">
                            <img src="~/images/icons/delete-header.svg" class="p-2  menu-category-image-delete" alt="">
                        </a>
                    </p>
                }
                else
                {
                    <p class="delete-styles cursor-none" disabled>
                        <a class="text-decoration-none text-black   add-user-link cursor-none">
                            <img src="~/images/icons/delete-header.svg" class="p-2  menu-category-image-delete cursor-none"
                                alt="">
                        </a>
                    </p>
                }
                @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
                {
                    <p class="delete-styles d-block d-md-none d-flex justify-content-center align-items-center"
                        data-bs-toggle="modal" data-bs-target="#addItemModal" style="width: 49px; height: 49px;">
                        <button type="button" class="text-decoration-none text-black btn  add-user-link">
                            <img src="~/images/icons/plus-header.svg" class="p-2 menu-category-image-delete" alt="">
                        </button>
                    </p>
                }
                else
                {
                    <p class="delete-styles d-block d-md-none d-flex justify-content-center align-items-center cursor-none"
                        style="width: 49px; height: 49px;">
                        <button type="button" class="text-decoration-none text-black btn  add-user-link cursor-none">
                            <img src="~/images/icons/plus-header.svg" class="p-2 menu-category-image-delete cursor-none"
                                alt="">
                        </button>
                    </p>
                }
                @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
                {
                    <button type="button" id="AddItemModal" onclick="addItem()"
                        class="d-none d-md-block button-styles-header w-100 add-item-button">
                        <a class="text-decoration-none text-white add-user-link gap-2 d-flex justify-content-center">
                            <p>+</p>
                            <p class="d-none d-sm-block">Add Item</p>
                        </a>
                    </button>
                }
                else
                {
                    <button type="button" id="AddItemModal" class="d-none d-md-block button-styles-header w-100 add-item-button"
                        style="cursor: not-allowed;">
                        <a
                            class="text-decoration-none text-white add-user-link gap-2 d-flex justify-content-center cursor-none">
                            <p>+</p>
                            <p class="d-none d-sm-block">Add Item</p>
                        </a>
                    </button>
                }
            </div>
        </div>

        <div class="table-responsive col-12 form-bg mx-4 p-3 mb-3 mx-auto">


            <div id="partialViewStartingInner" class="">


                <partial name="_ItemTable" model="@Model" />

            </div>

        </div>
    </div>


</div>



@* delete multiple items *@
<div class="modal fade" id="deleteItems" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete
                    Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column align-items-center justify-content-center">
                <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete these items?</p>
            </div>
            <div class="modal-footer">
                <button id="deleteItemButtons" type="button" class="btn btn-primary px-3" data-bs-dismiss="modal"
                    onclick="deleteSelectedItems()">Yes</button>
                <a href="./menu.html"><button type="button" class="btn btn-contrast px-3">No</button></a>
            </div>
        </div>
    </div>
</div>

@* add category *@
<div class="modal fade" id="categoryModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Add Category
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="category-name" id="CategoryName" required
                        placeholder="name">
                    <label for="category-name" class="">Name</label>
                    <span id="categoryNameError" class="text-danger"></span>
                </div>
                <div class="form-floating">
                    <input type="text" class="form-control" name="category-description" id="CategoryDescription"
                        required placeholder="category-description">
                    <label for="category-description" class="">Description</label>
                    <span id="categoryDescriptionError" class="text-danger"></span>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <button onclick="AddCategory()" type="submit" class="btn btn-primary px-3">Save</button>
                <a asp-controller="Menu" asp-action="Index"><button type="button"
                        class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>

@* edit category *@
<div class="modal fade" id="editCategoryModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Edit Category
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-floating mb-3">
                    <input id="EditCategoryId" class="d-none">
                    <input type="text" class="form-control" name="CategoryName" id="EditCategoryName" required
                        placeholder="name">
                    <label for="category-name" class="">Name</label>
                    <span id="editCategoryNameError" class="text-danger"></span>
                </div>
                <div class="form-floating">
                    <input type="text" class="form-control" name="category-description" id="EditCategoryDescription"
                        required placeholder="category-description">
                    <label for="category-description" class="">Description</label>
                    <span id="editCategoryDescriptionError" class="text-danger"></span>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <button  onclick="EditCategory()" id="EditCategoryModal" type="button"
                    class="btn btn-primary px-3">Save</button>
                <a asp-controller="Menu" asp-action="Index"><button type="button"
                        class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>

@* delete category *@
<div class="modal fade" id="categoryDeleteModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex align-items-center flex-column">
                <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete this category?</p>
            </div>
            <div class="modal-footer d-flex justify-content-center">
                <button id="deleteCategoryButton" type="button" class="btn btn-primary px-3"
                    data-bs-dismiss="modal">Yes</button>
                <a asp-controller="Menu" asp-action="Index"><button type="button"
                        class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>

@* add and edit item *@
<div id="AddItemModalPartial">
    <partial name="_AddItemPartial" model="@Model" />
</div>

<script>
    var isEditCalled = false;
    var deleteItemsList = [];

    function addItem() {
        console.log(selectModifierGroups);
        initializeFormSubmit();
        if (isEditCalled) {
            UnSyncEditChanges();
            $.ajax({
                type: "GET",
                url: "/Menu/ResetAddItemForm",
                success: function (data) {
                    selectModifierGroups = [];
                    $("#AddItemModalPartial").html(data);
                    triggerMultiSelect();
                    $("#AddItemModalHeading").text("Add Item");
                    $("#AddItemButton").text("Save");
                    $("#addItemModal").modal("show");
                    $.validator.unobtrusive.parse("#AddItemForm");
                    initializeFormSubmit();
                },
                error: function (data) {
                    console.log(data);
                }
            });
            return;
        }
        if (!isEditCalled) {
            triggerMultiSelect();
        }
        $("#AddItemModalHeading").text("Add Item");
        $("#AddItemButton").text("Save");
        $("#addItemModal").modal("show");
        $("#addItemModal").modal('show');
        return;
    }

    function showDiv(divId) {
        divId.classList.remove('d-none');
        var divId2 = divId.id + "2";
        $("#" + divId2).addClass('active-category-div'); 
    }

    function hideDiv(divId) {
        divId.classList.add('d-none');
        var divId2 = divId.id + "2";
        $("#" + divId2).removeClass('active-category-div');
    }

    function AddCategory() {
        var Name = $("#CategoryName").val();
        var Description = $("#CategoryDescription").val();
        if (Name == "") {
            $("#categoryNameError").text("Category Name is required");
            return;
        } else {
            $("#categoryNameError").text("");
        }
        $.ajax({
            url: '/Menu/AddCategory',
            type: 'POST',
            data: { categoryName: Name, categoryDescription: Description },
            success: function (data) {
                if (data.success) {
                    toastr.success(data.message);
                    
                    $.ajax({
                        type: "GET",
                        url: "/Menu/RefreshItemsPartial",
                        success: function (data) {
                            $("#partialViewStarting").html(data);
                        },
                        error: function (data) {
                            console.log(data);
                        }
                    });
                    $("#categoryModal").modal("hide");
                } else {
                    if (data.message != null) {
                        toastr.error(data.message);
                    } else {
                        toastr.error("Not Authorized");
                    }
                }
            },
            error: function (data) {
                toastr.error(data.message);
            }
        });
    }

    function EditCategory() {
        var Id = $("#EditCategoryId").val();
        var Name = $("#EditCategoryName").val();
        var Description = $("#EditCategoryDescription").val();
        if (Name == "") {
            $("#editCategoryNameError").text("Category Name is required");
            return;
        } else {
            $("#editCategoryNameError").text("");
        }
        $.ajax({
            url: '/Menu/UpdateCategory',
            type: 'PUT',
            data: { categoryId: Id, categoryName: Name, categoryDescription: Description },
            success: function (data) {
                if (data.success) {
                    toastr.success(data.message);
                    $.ajax({
                        type: "GET",
                        url: "/Menu/RefreshItemsPartial",
                        data: { categoryId: Id },
                        success: function (data) {
                            $("#partialViewStarting").html(data);
                        },
                        error: function (data) {
                            console.log(data);
                        }
                    });
                    $("#editCategoryModal").modal("hide");
                } else {
                    if (data.message != null) {
                        toastr.error(data.message);
                    } else {
                        toastr.error("Not Authorized");
                    }
                }
            },
            error: function (data) {
                toastr.error(data.message);
            }
        });
    }
</script>
