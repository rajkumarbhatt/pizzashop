@using DAL.ViewModels
@model DAL.ViewModels.MenuViewModel
@{
    var permissionList = new List<PermissionModel>();

    if (Context.Session.Get("permissions") != null)
    {
        permissionList = System.Text.Json.JsonSerializer.Deserialize<List<PermissionModel>>(Context.Session.Get("permissions"));
    }

}
<table id="userTable" class="table table-responsive" style="white-space: nowrap;">
    <thead class="color-head">
        <tr class="text-center">
            <th class="text-start mx-2">
                <input class="form-check-input intermediate-checkbox" type="checkbox" value=""
                    id="DeleteItemsIntermediateCheckbox" style="height: 1em;">
                <label class="form-check-label" for="flexCheckIndeterminate"></label>Name
            </th>
            <th>Item type</th>
            <th>Rate</th>
            <th>Quantity</th>
            <th>Available</th>
             @if(permissionList != null && permissionList.Any(p => p.Name == "Menu" && (p.CanEdit == true || p.CanDelete == true)))
            {
                <th>Action</th>
            }
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {

            <tr class="text-center">
                <td class="text-start mx-2 d-flex align-items-center table-checkbox-gap">
                    @{
                        string profileImagePath = string.IsNullOrEmpty(@item.ImageUrl)
                        ? "/images/dining-menu.png"
                        : $"/images/item-images/{@item.ImageUrl}";
                    }
                    <input onclick="addItemToDeleteList(@item.Id)"
                        class="form-check-input permission-checkbox item-name-checkbox" type="checkbox" value="@item.Id"
                        style="height: 1em;">
                    <img src="@profileImagePath" class="table-name-image profile-image-border object-fit-cover" alt="">
                    <label class="form-check-label" for="defaultCheck1">@item.Name
                </td>
                <td>
                    @if (item.ItemType == "Vegetarian")
                    {
                        <img src="~/images/icons/veg-icon.svg" class="small-image" alt="">
                    }
                    else
                    {
                        <img src="~/images/icons/non-veg-icon.svg" class="small-image" alt="">
                    }
                </td>
                <td>@item.Price</td>
                <td>@item.Quantity</td>
                <td>
                    @{
                        var idCustom = "flexSwitchCheckChecked" + item.Id;
                    }
                    @if (item.IsAvailable ?? false)
                    {
                        <div class="form-check form-switch">
                            <input disabled  style="opacity:1" class="form-check-input form-check-switch" onclick="saveChangesOfSwitch(@item.Id)"
                                type="checkbox" checked id="@idCustom">
                        </div>
                    }
                    else
                    {
                        <div class="form-check form-switch">
                            <input disabled  style="opacity:1" class="form-check-input form-check-switch" onclick="saveChangesOfSwitch(@item.Id)"
                                type="checkbox" id="@idCustom">
                        </div>
                    }
                </td>
                <td>
                    @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanEdit == true))
                    {
                        <button onclick="editItem(@item.Id)" type="button" class="edit-btn btn">
                            <a> <img src="~/images/icons/edit.svg" class="small-image" alt=""></a></button>
                    }
                    @if (permissionList != null && permissionList.Any(p => p.Name == "Menu" && p.CanDelete == true))
                    {
                        <button onclick="deleteItem(@item.Id)" type="button" class="delete-btn" data-bs-toggle="modal"
                            data-bs-target="#deleteItem">
                            <a> <img src="~/images/icons/delete.svg" class="small-image" alt=""></a></button>
                    }
                </td>
                <input asp-for="@Model.AddItemViewModel.Id" name="AddItemViewModel.Id" id="ItemId" type="hidden"
                    value="@item.Id" />
            </tr>
        }
    </tbody>
</table>
<div class="d-flex flex-column flex flex-sm-row align-items-center justify-content-end g-3">
    <p>Items per page: </p>
    <select id="PageSize" class="form-select pagination-dropdown text-black" aria-label="Items per page"
        onchange="changePageSize(this.value)">
        <option value="5" selected="@(Model.PageSize == 5 ? "selected" : null)">5</option>
        <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
        <option value="15" selected="@(Model.PageSize == 15 ? "selected" : null)">15</option>
    </select>
    <p class="px-1">
        <input type="hidden" id="PageIndex" value="@Model.PageIndex" />
        Showing @((Model.PageIndex - 1) * Model.PageSize + 1) -
        @(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalItems)) of
        @Model.TotalItems
    </p>


    <div>
    </div>
    <button id="previousButton" class="p-1 px-2" @(Model.PageIndex == 1 ? "disabled" : "")>&lt;</button>

    <button id="nextButton" class="p-1 px-2 ms-1 border-1 border-secondary" @(((Model.PageIndex == Model.TotalPages) || Model.TotalPages == 0) ?
        "disabled" : "")> &gt;</ button >
</div>


@* delete item *@
<div class="modal fade" id="deleteItem" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete
                    Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column align-items-center justify-content-center">
                <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete this item?</p>
            </div>
            <div class="modal-footer">
                <button id="deleteItemButton" type="button" class="btn btn-primary px-3">Yes</button>
                <a data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">No</button></a>
            </div>
        </div>
    </div>
</div>


<script>

    $("#DeleteItemsIntermediateCheckbox").click(function () {
        if (this.checked) {
            $(".item-name-checkbox").prop("checked", true);
            $(".item-name-checkbox").each(function () {
                var itemIdTemp = parseInt($(this).val());
                if (!deleteItemsList.includes(itemIdTemp)) {
                    deleteItemsList.push(itemIdTemp);
                }
            });
        } else {
            $(".item-name-checkbox").prop("checked", false);
            $(".item-name-checkbox").each(function () {
                var itemIdTemp = parseInt($(this).val());
                deleteItemsList = deleteItemsList.filter(item => item !== itemIdTemp);
            });
        }
        console.log(deleteItemsList);
    });

    $(".item-name-checkbox").click(function () {
        if ($(".item-name-checkbox:checked").length === $(".item-name-checkbox").length) {
            $("#DeleteItemsIntermediateCheckbox").prop("checked", true);
        } else {
            $("#DeleteItemsIntermediateCheckbox").prop("checked", false);
        }
        console.log(deleteItemsList);
    });

    function addItemToDeleteList(itemId) {
        itemId = parseInt(itemId);
        if (deleteItemsList.includes(itemId)) {
            deleteItemsList = deleteItemsList.filter(item => item !== itemId);
        } else {
            deleteItemsList.push(itemId);
        }
        console.log(deleteItemsList);
    }

    var isDeleting = false;

    function deleteSelectedItems() {
        if (isDeleting) return; 
        isDeleting = true;

        deleteItemsList = deleteItemsList.map(item => parseInt(item));
        if (deleteItemsList.length === 0) {
            toastr.error("Please select at least one item to delete.");
            isDeleting = false; 
            return;
        }
        $.ajax({
            url: '@Url.Action("DeleteSelectedItems", "Menu")',
            type: 'DELETE',
            data: { itemIds: deleteItemsList },
            success: function (data) {
                isDeleting = false;  
                if (data.success) {
                    toastr.success(data.message);
                    deleteItemsList = [];
                    $.ajax({
                        type: "GET",
                        url: "/Menu/ItemsFilter",
                        data: { categoryId: $("#categoryId").val(), pageIndex:1, pageSize: $("#PageSize").val() },
                        success: function (data) {
                            $("#partialViewStartingInner").html(data);
                        },
                        error: function (data) {
                            console.log(data);
                        }
                    });
                    $("#deleteItems").modal("hide");
                } else {
                    toastr.error(data.message);
                }
            },
            error: function (err) {
                isDeleting = false;
                console.log(err);
            }
        });
    }

    $("#nextButton").click(function () {
        const currentPageIndex = @Model.PageIndex;
        const nextPageIndex = currentPageIndex + 1;
        const searchValue = $("#searchInput").val().toLowerCase();
        const pageSize = @Model.PageSize;
        const categoryId = $("#categoryId").val();
        console.log(categoryId);
        $.ajax({
            url: '@Url.Action("ItemsFilter", "Menu")',
            type: 'GET',
            data: { pageIndex: nextPageIndex, pageSize: pageSize, categoryId: categoryId, searchValue: searchValue },
            success: function (data) {
                $("#partialViewStartingInner").html(data);
            }
        });
    });

    $("#previousButton").click(function () {
        const currentPageIndex = @Model.PageIndex;
        const nextPageIndex = currentPageIndex - 1;
        const searchValue = $("#searchInput").val().toLowerCase();
        const pageSize = @Model.PageSize;
        const categoryId = $("#categoryId").val();
        $.ajax({
            url: '@Url.Action("ItemsFilter", "Menu")',
            type: 'GET',
            data: { pageIndex: nextPageIndex, pageSize: pageSize, categoryId: categoryId, searchValue: searchValue },
            success: function (data) {
                $("#partialViewStartingInner").html(data);
            }
        });
    });

    function changePageSize(pageSize) {
        const nextPageIndex = 1;
        const searchValue = $("#searchInput").val().toLowerCase();
        const categoryId = $("#categoryId").val();
        $.ajax({
            url: '@Url.Action("ItemsFilter", "Menu")',
            type: 'GET',
            data: { pageIndex: nextPageIndex, pageSize: pageSize, categoryId: categoryId, searchValue: searchValue },
            success: function (data) {
                $("#partialViewStartingInner").html(data);
            }
        });
    }

    $("#searchInput").on("keyup", function () {
        clearTimeout($.data(this, 'timer'));
        var searchValue = $(this).val().toLowerCase();
        var categoryId = $("#categoryId").val();
        $(this).data('timer', setTimeout(function () {
            const currentPageIndex = 1;
            const pageSize = @Model.PageSize;
            $.ajax({
                url: '@Url.Action("ItemsFilter", "Menu")',
                type: 'GET',
                data: { pageIndex: currentPageIndex, pageSize: pageSize, categoryId: categoryId, searchValue: searchValue },
                success: function (data) {
                    $("#partialViewStartingInner").html(data);
                }
            });
        }, 300));
    });

    $("#searchInput2").on("keyup", function () {
        clearTimeout($.data(this, 'timer'));
        var searchValue = $(this).val().toLowerCase();
        var categoryId = $("#categoryId").val();
        $(this).data('timer', setTimeout(function () {
            const currentPageIndex = 1;
            const pageSize = @Model.PageSize;
            $.ajax({
                url: '@Url.Action("ItemsFilter", "Menu")',
                type: 'GET',
                data: { pageIndex: currentPageIndex, pageSize: pageSize, categoryId: categoryId, searchValue: searchValue },
                success: function (data) {
                    $("#partialViewStartingInner").html(data);
                }
            });
        }, 300));
    });

    function saveChangesOfSwitch(itemId) {
        var idCustom = "flexSwitchCheckChecked" + itemId;
        var isAvailable = document.getElementById(idCustom).checked;
        console.log(isAvailable);
        $.ajax({
            url: '@Url.Action("UpdateItemAvailability", "Menu")',
            type: 'POST',
            data: { itemId: itemId, isAvailable: isAvailable },
            success: function (data) {
            }
        });
    }

    function changeItems(categoryId) {
        var searchValue = $("#searchInput").val().toLowerCase();
        $.ajax({
            url: '@Url.Action("ItemsFilter", "Menu")',
            type: 'GET',
            data: { pageIndex: 1, pageSize: $("#PageSize").val(), categoryId: categoryId, searchValue: searchValue },
            success: function (data) {
                $("#categoryId").val(categoryId);
                $("#partialViewStartingInner").html(data);
                $(".menu-category-navigation-items").removeClass("active-nav-item");
                $("#div" + categoryId + "4").addClass("active-nav-item");
                $(".gray-dot").removeClass("d-none");
                $("#grayDot" + categoryId).addClass("d-none");
                $(".blue-dot").addClass("d-none");
                $("#blueDot" + categoryId).removeClass("d-none");
            }
        });
        deleteItemsList.forEach(item => {
            $(".item-name-checkbox").each(function () {
                if (parseInt($(this).val()) === item) {
                    $(this).prop("checked", true);
                }
            });
        });
        deleteItemsList = [];
    }

    function makeThisCategoryActive(categoryId) {
        $(".menu-category-navigation-items").removeClass("active-nav-item");
        $("#div" + categoryId + "4").addClass("active-nav-item");
        $(".gray-dot").removeClass("d-none");
        $("#grayDot" + categoryId).addClass("d-none");
        $(".blue-dot").addClass("d-none");
        $("#blueDot" + categoryId).removeClass("d-none");
    }

    function deleteItem(itemId) {
        var currentCategoryId = $("#categoryId").val();
        var currentPageIndex = $("#PageIndex").val();
        var currentPageSize = $("#PageSize").val();
        console.log(currentCategoryId);
        console.log(currentPageIndex);
        console.log(currentPageSize);
        $("#deleteItemButton").off("click").click(function () {
            $.ajax({
                url: '@Url.Action("DeleteItem", "Menu")',
                type: 'DELETE',
                data: { itemId: itemId },
                success: function (data) {
                    if (data.success) {
                        toastr.success(data.message);
                        $.ajax({
                            type: "GET",
                            url: "/Menu/ItemsFilter",
                            data: { categoryId: currentCategoryId, pageIndex: currentPageIndex, pageSize: currentPageSize },
                            success: function (data) {
                                $("#partialViewStartingInner").html(data);
                            },
                            error: function (data) {
                                console.log(data);
                            }
                        });
                        $("#deleteItem").modal("hide");
                    } else {
                        toastr.error(data);
                    }
                }
            });
        });
    }



    $(document).off("one").one('keydown', function (e) {
        if (e.key === "Delete" && isItem) {
            deleteSelectedItems();
        }
    });

    

    deleteItemsList.forEach(item => {
        $(".item-name-checkbox").each(function () {
            if (parseInt($(this).val()) === item) {
                $(this).prop("checked", true);
            }
        });
    });

    if ($(".item-name-checkbox:checked").length === $(".item-name-checkbox").length) {
        $("#DeleteItemsIntermediateCheckbox").prop("checked", true);
    } else {
        $("#DeleteItemsIntermediateCheckbox").prop("checked", false);
    }

    if ($(".item-name-checkbox:checked").length == 0) {
        $("#DeleteItemsIntermediateCheckbox").prop("checked", false);
    }

</script>