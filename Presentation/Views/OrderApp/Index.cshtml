@{
    Layout = "~/Views/Shared/_LayoutOrderApp.cshtml";
}
@model DAL.ViewModels.OrderAppViewModel


<div style="background-color: #F2F2F2;" style="width: 90%;">

    <div class="d-flex justify-content-between align-items-center" style="width: 97%;">
        <h1 class="main-page-heading">Table View</h1>
        <div class="d-flex gap-2">
            <div class="d-flex gap-1 justify-content-center align-items-center">
                <p class="available-kot"></p>
                <p>Available</p>
            </div>
            <div class="d-flex gap-1 justify-content-center align-items-center">
                <p class="selected-kot"></p>
                <p>Selected</p>
            </div>
            <div class="d-flex gap-1 justify-content-center align-items-center">
                <p class="assigned-kot"></p>
                <p>Assigned</p>
            </div>
            <div class="d-flex gap-1 justify-content-center align-items-center">
                <p class="running-kot"></p>
                <p>Running</p>
            </div>
        </div>
    </div>

    <div id="partialViewOfSections">
        <partial name="_SectionDropdown" model="@Model" />
    </div>
</div>