@model DAL.ViewModels.OrderDetailsViewModel

<div class="mx-auto d-flex justify-content-between align-items-center w-65">
    <h1 class="main-page-heading">Order Details</h1>
    <a asp-controller="Order" asp-action="Index" style="width: 80px; height: 38px;">
        <button class="btn btn-contrast mx-0 mx-sm-1" style="width: 80px; height: 38px;">< Back</button>
    </a>
</div>

<div class="ps-4 form-bg p-2 my mx-auto table-responsive w-61">
    <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex gap-2 align-items-center">
            <h4>Order Summary</h4>
            <div class="custom-order-border">@Model.OrderStatus</div>
        </div>
        <div>
            <button id="downloadInvoice" onclick="downloadPdfInvoice(@Model.Id)" class="d-none d-md-block button-styles" style="height: 44px; width: 120px;">
                <a class="text-decoration-none text-white add-user-link">
                    <img src="~/images/icons/export.svg" class="p-1" style="width: 40px;" alt="">
                    <span class="text-white fw-bold">Export</span>
                </a>
            </button>
        </div>
    </div>
    <div class="d-flex gap-3 flex-column">
        <div>
            <span class="fw-bold23">Invoice No. :</span> @Model.InvoiceNumber
        </div>
        <div class="d-flex gap-3 ">
            <div>
                <span class="fw-bold23">Placed On :</span> @Model.PlacedOn
            </div>
            <div>
                <span class="fw-bold23">Modified On :</span> @Model.ModifiedOn
            </div>
            <div>
                <span class="fw-bold23">Paid On :</span> @Model.PaidOn
            </div>
            <div>
                <span class="fw-bold23">Duration :</span> @Model.OrderDuration
            </div>
        </div>
    </div>
</div>
<div class="d-flex flex-column flex-sm-row gap-2 p-2 my mx-auto table-responsive w-61">
    <div class="ps-4 form-bg p-2 my mx-auto table-responsive d-flex gap-3 flex-column w-100 w-sm-50">
        <div class="pt-2">
            <img src="~/images/icons/customer-details.svg" class="small-image cursor-pointer anchor-tag " alt="">
            <span style="font-weight: 650;">
                Customer Details
            </span>
        </div>
        <div>
            <p>Name: @Model.CustomerName</p>
            <p>Phone: @Model.CustomerPhone</p>
            <p>No of Person: @Model.NumberOfPeople</p>
            <p>Email: @Model.CustomerEmail</p>
        </div>
    </div>
    <div class="ps-4 form-bg p-2 my mx-auto table-responsive d-flex gap-3 flex-column w-100 w-sm-50">
        <div class="pt-2">
            <img src="~/images/icons/table-details.svg" class="small-image cursor-pointer anchor-tag " alt="">
            <span style="font-weight: 650;">
                Table Details
            </span>
        </div>
        <div>
            @{
                string tables = "";
                foreach (var table in Model.Tables)
                {
                    tables += table.Name + ", ";
                }
                tables = tables.Remove(tables.Length - 2);
            }
            <p>Table: @tables</p>
            <p>Section: @Model.Section</p>
        </div>
    </div>
</div>

<div class="ps-4 form-bg p-2 my mx-auto table-responsive w-61">
    <span style="font-weight: 650;">Order Items</span>
    <table id="userTable" class="table table-responsive" style="white-space: nowrap;">
        <thead class="">
            <tr class="text-start">
                <td>Sr.No</td>
                <td>Name</td>
                <td>Quantity</td>
                <td>Price</td>
                <td class="text-end">Total Amount</td>
            </tr>
        </thead>
        <tbody class="">
            @{var row = 1;}
            @foreach (var item in Model.InvoiceItems)
            {
                <tr>
                    <td>@row</td>
                    <td>
                        @item.Item
                        <ul>
                            @foreach (var modifier in item.InvoiceModifiers)
                            {
                                <li>@modifier.Item</li>
                            }
                        </ul>
                    </td>
                    <td class="d-flex flex-column">
                        <span>@item.Quantity</span>
                        @foreach (var modifier in item.InvoiceModifiers)
                        {
                            <span>@modifier.Quantity</span>
                        }
                    </td>
                    <td class="">
                        <div class="d-flex flex-column ">
                            <span>₹@item.Price</span>
                            @foreach (var modifier in item.InvoiceModifiers)
                            {
                                <span>₹@modifier.Price</span>
                            }
                        </div>
                    </td>
                    <td class="text-end">
                        <div class="d-flex flex-column">
                            <span>₹@item.TotalAmount</span>
                            @foreach (var modifier in item.InvoiceModifiers)
                            {
                                <span>₹@modifier.TotalAmount</span>
                            }
                        </div>
                    </td>
                    @{row++;}
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex flex-column align-items-end">
        <table ">
            <tr>
                <td style=" font-weight: 550;">Sub Total:</td>
            <td class="text-end">₹@Model.SubTotal</td>
            </tr>
            @foreach (var tax in @Model.InvoiceTaxes)
            {
                <tr>
                    <td style="font-weight: 550;">@tax.TaxName:</td>
                    <td class="text-end">₹@tax.TaxAmount</td>
                </tr>
            }
            <tr>
                <td style="font-weight: 550; ">Total:</td>
                <td class="text-end">₹@Model.Total</td>
            </tr>
        </table>
    </div>

    <script src="/js/orderDetails.js" asp-append-version="true"></script>