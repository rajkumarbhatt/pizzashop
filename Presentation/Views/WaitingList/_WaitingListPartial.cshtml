@model DAL.ViewModels.WaitingListViewModel

<div class="d-flex mx-auto py-2 flex-column gap-2  form-bg shadow  mb-3 table-responsive" style=" width: 95%;">
    <div class="ps-3 d-flex justify-content-start align-items-center gap-3 h-100 " style="white-space: nowrap;">
        @foreach (var sectionWithCount in Model.SectionAndNumberOfWaitingLists)
        {
            var paraId = "para" + sectionWithCount.SectionId;
            @if (sectionWithCount.SectionId == 0)
            {
                <div id="@sectionWithCount.SectionId"
                    class="d-flex justify-content-center gap-1 align-items-center cursor-pointer section-tabs active-waiting-list"
                    onclick="changeSection(id)">
                    <p id="@paraId" class="text-gray active-waiting-list">@sectionWithCount.SectionName</p>
                    <div class="gray-circle d-flex justify-content-center align-items-center text-white">
                        @sectionWithCount.NumberOfWaitingList
                    </div>
                </div>
            }
            else
            {
                <div id="@sectionWithCount.SectionId"
                    class="d-flex justify-content-center gap-1 align-items-center cursor-pointer section-tabs"
                    onclick="changeSection(id)">
                    <p id="@paraId" class="text-gray">@sectionWithCount.SectionName</p>
                    <div class="gray-circle d-flex justify-content-center align-items-center text-white">
                        @sectionWithCount.NumberOfWaitingList
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="form-bg shadow mx-auto table-responsive" style="width: 95%;">
    <div id="waitingListTablePartial">
        <partial name="_WaitingListTablePartial" model="@Model" />
    </div>
    </tbody>
    </table>
</div>

<div id="waitingListModalStarting">
    <partial name="_WaitingTokenModal" model="@Model" />
</div>

@* delete modal *@
<div class="modal fade" id="deleteWaitingList" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Delete
                    Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column align-items-center justify-content-center">
                <img src="~/images/icons/warning.svg" class="medium-image" alt="">
                <p>Are you sure you want to delete this customer form Waiting List?</p>
            </div>
            <div class="modal-footer">
                <button id="deleteButton" type="button" class="btn btn-primary px-3"
                    data-bs-dismiss="modal">Yes</button>
                <a data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">No</button></a>
            </div>
        </div>
    </div>
</div>

@* assign table modal *@
<div class="modal fade" id="AssignTableModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Assign Table</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column align-items-center justify-content-center">
                <div class="col-12 row gap-2">
                    <div class="form-floating my-auto col-12 col-md-6">
                        <select id="selectSection" class="border border-black form-select" aria-label="CategoryId" style="width: 98%;"
                            asp-for="@Model.waitingListModal.SectionId" onchange="getTables(this.value)">
                            <option value="" selected hidden>Select Section</option>
                            @foreach (var Section in Model.Sections)
                            {
                                <option value="@Section.Id">@Section.Name</option>
                            }
                        </select>
                        <label for="NumberOfPeopleWaitingList" class="">Section*</label>
                    </div>
                    <button
                        class="custom-select-waiting-list btn border border-black dropdown-toggle col-12 col-md-6 d-flex justify-content-between align-items-center" style="width: 48%;"
                        type="button" id="custom-multiselect" data-bs-toggle="dropdown" aria-expanded="false">
                        <span>Select Table(s)</span>
                        <span class="ms-auto dropdown-arrow"></span>
                    </button>
                    <ul class="dropdown-menu p-2" id="selectTableUl" aria-labelledby="custom-multiselect" style="width: 46%;">
                        <li>
                            @* <input type="checkbox" style="height:1em;" class="form-check-input multi-checkbox"
                                value="-1">
                            <label class="form-check-label">Select Table</label> *@
                        </li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end gap-2">
                <button id="assgnTableToCustomerButton" type="button" class="btn btn-primary px-3">Yes</button>
                <a data-bs-dismiss="modal"><button type="button" class="btn btn-contrast px-3">No</button></a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script src="/js/waitingList.js" asp-append-version="true"></script>