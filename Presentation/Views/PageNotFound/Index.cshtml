@{
    Layout = null;
    ViewBag.Title = "Page Not Found";
}
    <title>
        Page Not Found
    </title>

<style>
    body {
        background-color: #d9f0ff;
        text-align: center;
        font-family: Arial, sans-serif;
    }

    .container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .logo {
        font-size: 24px;
        font-weight: bold;
        color: #0056b3;
    }

    .error-code {
        font-size: 100px;
        font-weight: bold;
        color: #0056b3;
    }

    .error-message {
        font-size: 20px;
        color: #333;
    }

    .sub-message {
        color: #0056b3;
    }
</style>
    <div class="container">
        <div class="logo">PIZZASHOP</div>
        <div class="error-code">404</div>
        <div class="error-message">Page Not Found</div>
        <p class="sub-message">Oops, the page you're looking for isn't here.</p>
    </div>
