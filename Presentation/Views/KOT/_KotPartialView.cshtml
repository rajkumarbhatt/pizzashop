@model DAL.ViewModels.KotViewModel

<div class="mx-auto d-flex flex-column gap-3 form-bg shadow  table-responsive" style=" width: 95%;">
    <div class="mx-auto w-100" style="">
        <div class="d-flex justify-content-between align-items-center gap-2 w-100">
            <div>
                <h2 class="font-blue ps-4 pt-3">All</h2>
            </div>
            <div class="pe-4 d-flex gap-2">
                <button class="btn btn-primary">In Progress</button>
                <button class="btn btn-contrast">Ready</button>
                <button class="btn btn-contrast">
                    < </button>
                        <button class="btn btn-contrast"> > </button>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-start gap-3 p-4">
        @if (Model.KotOrderCards != null)
        {
            @foreach (var order in Model.KotOrderCards)
            {
                <div class=" ms-4 mb-4 box-kot-card-custom-border cursor-pointer" style="width: 350px; height: 320px;">
                    <div class=" w-100 text-dark bg-kot-card-top" style="height: 70px;">
                        <div class="d-flex justify-content-between py-1 px-2 align-items-center">
                            <h5 class=" kot-card-header-font">#@order.OrderId</h5>
                            <div class="d-flex gap-2 align-items-center">
                                <img src="~/images/icons/kot-navbar-clock-black.svg" class="small-image" alt="">
                                <p>@order.OrderDuration</p>
                            </div>
                        </div>
                        <div class="d-flex justify-content-start px-2 gap-2 align-items-center">
                            <p>@order.Section</p>
                            <p>•</p>
                            <p>@order.Table</p>
                        </div>
                    </div>
                    <div class="bg-white w-100 text-dark" style="height: 178px; overflow-y: scroll;">
                        @if (order.OrderItems != null)
                        {
                            @foreach (var item in order.OrderItems)
                            {
                                <div class="">
                                    <div class="d-flex justify-content-between pt-1 px-2 align-items-center">
                                        <p>@item.ItemName</p>
                                        <p>@item.ItemQuantity</p>
                                    </div>
                                    <div class="d-flex justify-content-start gap-2 pb-1 px-2 align-items-center">
                                        @if (item.Modifiers != null)
                                        {
                                            foreach (var modifier in item.Modifiers)
                                            {
                                                <p>•</p>
                                                <p>@modifier</p>
                                            }
                                        }
                                    </div>
                                    @if (!String.IsNullOrEmpty(item.ItemInstruction))
                                    {
                                        <div class="d-flex justify-content-start gap-2 pb-1 px-2 align-items-center">
                                            <p class="text-primary">Instruction</p>
                                            <p>@item.ItemInstruction</p>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                    <div class="bg-kot-card-top w-100 text-dark" style="height: 70px;">
                        @if (!String.IsNullOrEmpty(order.OrderInstruction))
                        {
                            <div class="d-flex justify-content-start gap-2 pb-1 px-2 align-items-center">
                                <p class="text-primary">Instruction</p>
                                <p>@order.OrderInstruction</p>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

</div>