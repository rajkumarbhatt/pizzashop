@model DAL.ViewModels.KotViewModel

@if (Model != null && Model.KotOrderCards != null && Model.KotOrderCards.Count > 0)
{
    <div class="modal fade" id="MarkedAsPreparedModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered customer-details-modal">
            <div class="modal-content">

                <div class="modal-header flex-column align-items-start pb-0">
                    <div class="d-flex justify-content-between w-100 p-2">
                        <h5 class="modal-title" id="addTableTitle">Order ID: #@Model.KotOrderCards[0].OrderId</h5>
                        <button onclick="clearMarkAsReadyList()" type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="Close"></button>
                    </div>
                    @if (!String.IsNullOrEmpty(@Model.KotOrderCards[0].OrderInstruction))
                    {
                        <div class="d-flex justify-content-start gap-2 pb-1 px-2 align-items-center">
                            <p class="text-primary">Instruction</p>
                            <p>@Model.KotOrderCards[0].OrderInstruction</p>
                        </div>
                    }
                </div>
                <div class="modal-body pb-0">
                    <div class="d-flex justify-content-between ">
                        <h6 class="ms-2">Item</h6>
                        <h6 class="me-3">Quantity</h6>
                    </div>
                    <p class="my-1 border-table-kot"></p>
                    <div style="">
                        @foreach (var item in @Model.KotOrderCards[0].OrderItems)
                        {
                            var checkboxId = item.Id + "checkbox" + item.OrderItemId + "-" + item.ItemQuantity;
                            <div class="d-flex justify-content-between mt-2">
                                <div class="">
                                    <div class="d-flex gap-2">
                                        <input type="checkbox" class="form-check-input ready-item-checkbox" id="@checkboxId"
                                            style="width: 18px;height: 18px;">
                                        <p>@item.ItemName</p>
                                    </div>
                                    @foreach (var modifier in item.Modifiers)
                                    {
                                        <div class="ms-3 d-flex justify-content-start gap-2 align-items-center">
                                            <p>•</p>
                                            <p>@modifier.ModifierName</p>
                                        </div>
                                    }
                                    @if (!String.IsNullOrEmpty(item.ItemInstruction))
                                    {
                                        <div class="d-flex justify-content-start gap-2 pb-1 px-2 align-items-center">
                                            <p class="text-primary">Instruction</p>
                                            <p>@item.ItemInstruction</p>
                                        </div>
                                    }
                                </div>
                                <div class="">
                                    @{
                                        var decreaseQuantityId = item.Id + "decreaseQuantity" + item.OrderItemId + "-" + item.ItemQuantity;
                                        var increaseQuantityId = item.Id + "increaseQuantity" + item.OrderItemId + "-" + item.ItemQuantity;
                                        var quantityId = item.Id + "quantity" + item.OrderItemId + "-" + item.ItemQuantity;
                                    }
                                    <div class="quantity-div-border p-2 me-2 cursor-pointer">
                                        <span id="@decreaseQuantityId" class="p-1 px-2" onclick="decreaseQuanity(id)"> - </span>
                                        <span id="@quantityId" class="p-1 px-1"> @item.ItemQuantity </span>
                                        <span id="@increaseQuantityId" class="p-1 px-2" onclick="increaseQuantity(id)"> +
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <p class="my-1 border-light-table-kot"></p>
                        }
                    </div>

                    <div class="modal-footer d-flex justify-content-end">
                        <button id="ModalButtonText" onclick="markItemAsReady()" type="button"
                            class="btn btn-primary font-weight-bold-slight">Marked As Prepared</button>
                        <button onclick="clearMarkAsReadyList()" type="button"
                            class="btn btn-contrast font-weight-bold-slight text-black"
                            data-bs-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
} else {
    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <h5 class="text-muted">No orders available.</h5>
    </div>
}

<script>
    var pageIndexOfModal = @Model.PageIndex;
    var orderIdOfModal = @Model.KotOrderCards[0].OrderId;
</script>
<script src="/js/kot.js" asp-append-version="true"></script>