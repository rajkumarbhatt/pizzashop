@model DAL.ViewModels.KotMenuViewModel

<div class="mt-3 d-flex flex-column w-100 h-100">
    <div style="height: 500px; overflow-y: scroll;">
        <div class="w-100 bg-white d-flex justify-content-start align-items-center px-3 py-2">
            <p class="font-weight-bold color-head-order font-size-thead text-start w-50" style="margin-left: 6%;">Item
            </p>
            <p class="font-weight-bold color-head-order font-size-thead" style="width: 15%; margin-left: 6.5%;">Quantity
            </p>
            <p class="font-weight-bold color-head-order font-size-thead ps-4" style="width: 15%;">Amount</p>
        </div>
        @if (Model.OrderDetailsCard != null && Model.OrderDetailsCard.OrderItemDetails != null)
        {
            <div id="accordianItemDetails" class="p-2">
                <script>
                    var orderItems = @Html.Raw(Json.Serialize(Model.OrderDetailsCard.OrderItemDetails));
                </script>
            </div>
        }
    </div>
    <div class="p-3">
        <hr>
        <div class="d-flex justify-content-between align-items-center w-100 font-accordian-head font-tax-head">
            <p>Subtotal</p>
            <p id="orderSubtotalValue">@Model.OrderDetailsCard.SubTotal</p>
        </div>
        @if (Model != null && Model.TaxesFees != null)
        {
            string taxList = "";
            @if (Model.AreItemsAdded == false)
            {
                <div id="taxListContainer" class="d-none">
                    @foreach (var tax in Model.TaxesFees)
                    {
                        if (tax.TaxName == "Other Tax")
                        {
                            <div class="d-flex justify-content-between align-items-center w-100 font-accordian">
                                <p>@tax.TaxName</p>
                                <p id="otherTaxValue">@tax.TaxAmount</p>
                            </div>
                        }
                        else if (tax.TaxName == "Service Tax")
                        {
                            var customTaxId = tax.TaxType + "-" + tax.TaxName + "-" + tax.TaxAmount + "-" + tax.TaxRate;
                            taxList += customTaxId + ",";
                            <div class="d-flex justify-content-between align-items-center w-100 font-accordian">
                                <p>
                                    <input id="serviceTaxCheckBox" checked class="form-check-input permission-checkbox item-name-checkbox" type="checkbox" style="height: 1em;">
                                    @tax.TaxName
                                </p>
                                <p id="@customTaxId" class="service-tax-value">@tax.TaxAmount</p>
                            </div>
                        }
                        else
                        {
                            var customTaxId = tax.TaxType + "-" + tax.TaxName + "-" + tax.TaxAmount + "-" + tax.TaxRate;
                            taxList += customTaxId + ",";
                            <div class="d-flex justify-content-between align-items-center w-100 font-accordian">
                                <p>@tax.TaxName</p>
                                <p id="@customTaxId">@tax.TaxAmount</p>
                            </div>
                        }
                    }
                    <input type="hidden" id="taxAmountIds" value="@taxList" />
                </div>
            }
            else
            {
                <div id="taxListContainer" class="d-none">
                    @foreach (var tax in Model.TaxesFees)
                    {
                        if (tax.TaxName == "Other Tax")
                        {
                            <div class="d-flex justify-content-between align-items-center w-100 font-accordian">
                                <p>@tax.TaxName</p>
                                <p id="otherTaxValue">@tax.TaxAmount</p>
                            </div>
                        }
                        else if (tax.TaxName == "Service Tax")
                        {
                            var customTaxId = tax.TaxType + "-" + tax.TaxName + "-" + tax.TaxAmount + "-" + tax.TaxRate;
                            taxList += customTaxId + ",";
                            <div class="d-flex justify-content-between align-items-center w-100 font-accordian">
                                <p>
                                    @if (@tax.TaxAmount > 0)
                                    {
                                        <input id="serviceTaxCheckBox" checked class="form-check-input permission-checkbox item-name-checkbox" type="checkbox" style="height: 1em;">
                                    }
                                    else
                                    {
                                        <input id="serviceTaxCheckBox" class="form-check-input permission-checkbox item-name-checkbox" type="checkbox" style="height: 1em;">
                                    }
                                    @tax.TaxName
                                </p>
                                <p id="@customTaxId" class="service-tax-value">@tax.TaxAmount</p>
                            </div>
                        }
                        else
                        {
                            var customTaxId = tax.TaxType + "-" + tax.TaxName + "-" + tax.TaxAmount + "-" + tax.TaxRate;
                            taxList += customTaxId + ",";
                            <div class="d-flex justify-content-between align-items-center w-100 font-accordian">
                                <p>@tax.TaxName</p>
                                <p id="@customTaxId">@tax.TaxAmount</p>
                            </div>
                        }
                    }
                    <input type="hidden" id="taxAmountIds" value="@taxList" />
                </div>
            }
        }
        <div class="d-flex justify-content-between align-items-center w-100 font-accordian-head font-tax-head">
            <p>Total</p>
            <p id="orderTotalValue">@Model.OrderDetailsCard.TotalPrice</p>
        </div>
        <div class="d-flex justify-content-between align-items-center w-100 font-accordian">
            <p>Payment Mode</p>
            <div class="d-flex gap-2">
                <input style="width: 16px; height: 16px" type="radio" id="cash" checked name="paymentMode" value="Cash"
                    disabled class="form-check-input">
                <label for="cash" class="form-check-label">Cash</label>
                <input style="width: 16px; height: 16px" type="radio" id="card" name="paymentMode" value="Card" disabled
                    class="form-check-input">
                <label for="card" class="form-check-label">Card</label>
                <input style="width: 16px; height: 16px" type="radio" id="upi" name="paymentMode" value="UPI" disabled
                    class="form-check-input">
                <label for="upi" class="form-check-label">UPI</label>
            </div>
        </div>
        <div class="buttons d-flex flex-wrap gap-2 justify-content-end align-items-center w-100 mt-4 ">
            <button onclick="saveOrder()" class="order-item-details button btn btn-primary"
                style="width: 30%;">Save</button>
            <button onclick="completeOrder()" class="order-item-details button btn btn-contrast"
                style="width: 30%;">Complete</button>
            <button onclick="downloadPdfInvoice()" class="order-item-details button btn btn-contrast"
                style="width: 30%;">Generate Invoice</button>
            <button onclick="cancelOrder()" class="order-item-details button btn btn-contrast"
                style="width: 30%;">Cancel</button>
        </div>
    </div>
</div>


<script>
    setTimeout(() => {
        syncItemsList();
    }, 100);
    var urlTemp = window.location.href;
    var orderIdTemp = parseInt(urlTemp.substring(urlTemp.lastIndexOf('/') + 1));
</script>
<script src="/js/orderAppMenu.js" asp-append-version="true"></script>