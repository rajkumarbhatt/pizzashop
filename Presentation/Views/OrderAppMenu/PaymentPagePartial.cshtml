@model DAL.ViewModels.KotMenuViewModel
@{
    Layout = null;
}

<button id="rzp-button1" hidden>Pay</button>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
var options = {
    "key": "@Model.PaymentViewModal.RazorpayKey",
    "amount": "@Model.PaymentViewModal.Amount", 
    "currency": "INR",
    "name": "@Model.PaymentViewModal.Name",
    "description": "@Model.PaymentViewModal.Description",
    "image": "https://i.ibb.co/DHMyqyQh/pizzashop-logo.png", 
    "order_id": "@Model.PaymentViewModal.OrderId",
    "handler": function (response){
        $.ajax({
            url: '/Payment/Complete', // Backend endpoint to process the payment
            type: 'POST',
            data: {
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_order_id: response.razorpay_order_id,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function () {
                @* toastr.success("Payment processed successfully!"); *@
                window.close();
            },
            error: function () {
                @* toastr.error("Failed to process payment. Please try again."); *@
            }
        });
    },
    "prefill": {
        "name": "@Model.PaymentViewModal.Name",
        "email": "@Model.PaymentViewModal.Email",
        "contact": "@Model.PaymentViewModal.PhoneNumber",
    },
    "notes": {
        "address": "@Model.PaymentViewModal.Address",
    },
    "theme": {
        "color": "#F37254"
    }
};
var rzp1 = new Razorpay(options);

window.onload = function(){
    document.getElementById('rzp-button1').click();
};

document.getElementById('rzp-button1').onclick = function(e){
    rzp1.open();
    e.preventDefault();
}
</script>