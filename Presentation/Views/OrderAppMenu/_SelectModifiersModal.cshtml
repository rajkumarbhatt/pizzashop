@model DAL.ViewModels.KotMenuViewModel

@if (Model.AddModifiersModal != null)
{
    <div class="modal fade" id="selectModifiersModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered table-modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addTableTitle">@Model.AddModifiersModal.ItemName</h5>
                    <button type="button" onclick="clearModifiersList()" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row align-items-center">
                        <div class="col-12 row">
                            @foreach (var modifierGroup in @Model.AddModifiersModal.ModifierGroups)
                            {
                                <div class="d-flex flex-column gap-2">
                                    <div class="d-flex align-items-center justify-content-start gap-2">
                                        <p class="text-start font-big font-weight-bold-slight">@modifierGroup.ModifierGroupName
                                        </p>
                                        <p>(You can choose minimum @modifierGroup.MinSelection and maximum
                                            @modifierGroup.MaxSelection options)</p>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var modifier in @modifierGroup.ModifierGroupItems)
                                        {
                                            var customId = "modifier-" + modifier.ModifierId + "-" + modifierGroup.ModifierGroupId + "-" + modifierGroup.MinSelection + "-" + modifierGroup.MaxSelection;
                                            @if (modifierGroup.MinSelection > 0)
                                            {
                                                <div id="@customId" class="d-flex flex-column gap-2 modifer-card-add-item-kot min-greater-than-zero"
                                                onclick="selectModifier(id)" data-modifier-group-id="@modifierGroup.ModifierGroupId" data-min-selection="@modifierGroup.MinSelection" data-max-selection="@modifierGroup.MaxSelection" >
                                                <p>@modifier.ModifierName</p>
                                                <p>@modifier.Price</p>
                                            </div>
                                            }
                                            else
                                            {
                                                <div id="@customId" class="d-flex flex-column gap-2 modifer-card-add-item-kot"
                                                onclick="selectModifier(id)">
                                                <p>@modifier.ModifierName</p>
                                                <p>@modifier.Price</p>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-end ">
                    <button id="AddModifiersButton" onclick="addModifiers(@Model.AddModifiersModal.ItemId)" type="button" class="btn btn-primary px-3">Save</button>
                    <a data-bs-dismiss="modal"><button onclick="clearModifiersList()" type="button" class="btn btn-contrast px-3">Cancel</button></a>
                </div>
            </div>
        </div>
    </div>
}

<script>
    var url = window.location.href;
    var orderId = url.substring(url.lastIndexOf('/') + 1);

    function selectModifier(id) {
        if (orderId != "Menu") {
            var modifierId = parseInt(id.split("-")[1]);
            var modifierGroupId = parseInt(id.split("-")[2]);
            var minSelection = parseInt(id.split("-")[3]);
            var maxSelection = parseInt(id.split("-")[4]);
            var selectedModifierGroup = selectedModifiers.filter(function (modifier) {
                return modifier.ModifierGroupId === modifierGroupId;
            });
            var selectedModifier = selectedModifiers.filter(function (modifier) {
                return modifier.ModifierId === modifierId;
            });
            var elements = document.getElementsByClassName("modifer-card-add-item-kot");
            if (selectedModifier.length == 0) {
                if (selectedModifierGroup.length < maxSelection) {
                    selectedModifiers.push({ ModifierId: modifierId, ModifierGroupId: modifierGroupId });
                    document.getElementById(id).classList.add("selected-modifier");
                } else {
                    toastr.error("You can select maximum " + maxSelection + " modifiers from this group");
                }
            } else {
                selectedModifiers = selectedModifiers.filter(function (modifier) {
                    return modifier.ModifierId !== modifierId;
                });
                document.getElementById(id).classList.remove("selected-modifier");
            }
        }
    }

    function clearModifiersList() {
        if (orderId != "Menu") {
            selectedModifiers = [];
            var elements = document.getElementsByClassName("modifer-card-add-item-kot");
            for (var i = 0; i < elements.length; i++) {
                elements[i].classList.remove("selected-modifier");
            }
        }
    }

    if (orderId == "Menu") {
        document.getElementById("AddModifiersButton").classList.add("d-none");
    }

    function addModifiers (itemId) {
        if (checkForMinMax())
        {
            var modifiers = selectedModifiers;
            var modifierIds = modifiers.map(function (modifier) {
                return modifier.ModifierId;
            });
            console.log(orderId, itemId, modifierIds);
            $.ajax({
                type: "POST",
                url: '@Url.Action("AddItemToOrder", "OrderAppMenu")',
                data: { orderId: orderId, itemId: itemId, modifierIds: modifierIds },
                success: function (data) {
                    if (data.success) {
                        $("#selectModifiersModal").modal("hide");
                        clearModifiersList();
                        
                        console.log(data.message);
                    } else {
                        console.error(data.message);
                    }
                },
                error: function () {
                    console.error("Error adding modifiers");
                }
            });
        }
    }

    function checkForMinMax () 
    {
        var getElementsByClassName = document.getElementsByClassName("min-greater-than-zero");
        for (var i = 0; i < getElementsByClassName.length; i++) {
            var element = getElementsByClassName[i];
            var modifierGroupId = parseInt(element.getAttribute("data-modifier-group-id"));
            var minSelection = parseInt(element.getAttribute("data-min-selection"));
            var maxSelection = parseInt(element.getAttribute("data-max-selection"));
            var selectedModifierGroup = selectedModifiers.filter(function (modifier) {
                return modifier.ModifierGroupId === modifierGroupId;
            });
            if (selectedModifierGroup.length < minSelection) {
                toastr.error("You must select minimum " + minSelection + " modifiers from this group");
                return false;
            }
        }
        return true;
    }
</script>