@model DAL.ViewModels.KotMenuViewModel

@if (Model.AddModifiersModal != null)
{
    <div class="modal fade" id="selectModifiersModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered table-modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addTableTitle">@Model.AddModifiersModal.ItemName</h5>
                    <button type="button" onclick="clearModifiersList()" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row align-items-center">
                        <div class="col-12 row">
                            @foreach (var modifierGroup in @Model.AddModifiersModal.ModifierGroups)
                            {
                                <div class="d-flex flex-column gap-2">
                                    <div class="d-flex align-items-center justify-content-start gap-2">
                                        <p class="text-start font-big font-weight-bold-slight">@modifierGroup.ModifierGroupName
                                        </p>
                                        <p>(You can choose minimum @modifierGroup.MinSelection and maximum
                                            @modifierGroup.MaxSelection options)</p>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var modifier in @modifierGroup.ModifierGroupItems)
                                        {
                                            var customId = "modifier-" + modifier.ModifierId + "-" + modifierGroup.ModifierGroupId + "-" + modifierGroup.MinSelection + "-" + modifierGroup.MaxSelection + "-" + modifier.Price + "-" + modifier.ModifierName;
                                            @if (modifierGroup.MinSelection > 0)
                                            {
                                                <div id="@customId" class="d-flex flex-column gap-2 modifer-card-add-item-kot min-greater-than-zero"
                                                onclick="selectModifier(id)" data-modifier-group-id="@modifierGroup.ModifierGroupId" data-min-selection="@modifierGroup.MinSelection" data-max-selection="@modifierGroup.MaxSelection" >
                                                <p>@modifier.ModifierName</p>
                                                <p>@modifier.Price</p>
                                            </div>
                                            }
                                            else
                                            {
                                                <div id="@customId" class="d-flex flex-column gap-2 modifer-card-add-item-kot"
                                                onclick="selectModifier(id)">
                                                <p>@modifier.ModifierName</p>
                                                <p>@modifier.Price</p>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-end ">
                    <button id="AddModifiersButton" onclick="addModifiers('@Model.AddModifiersModal.ItemId', '@Model.AddModifiersModal.ItemName', '@Model.AddModifiersModal.ItemPrice')" type="button" class="btn btn-primary px-3">Save</button>
                    <a data-bs-dismiss="modal"><button onclick="clearModifiersList()" type="button" class="btn btn-contrast px-3">Cancel</button></a>
                </div>
            </div>
        </div>
    </div>
}

<script>
    var itemTaxList = @Html.Raw(Json.Serialize(Model.ItemTaxes));
    var url = window.location.href;
    var orderId = url.substring(url.lastIndexOf('/') + 1);
</script>
<script src="~/js/orderAppMenu.js"></script>