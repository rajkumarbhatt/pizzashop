@model DAL.ViewModels.KotMenuViewModel
@{
    var orderId = ViewBag.OrderId;
}

<div class="d-flex">
    <div id="thisDivIsImportant">
        <div class="d-flex justify-content-between" style="height: min-content;">
            <div class="input-group search-box m-3 search-box-kot-menu">
                <input type="text" class="form-control bg-white search-input py-1 py-sm-2" id="searchKotMenuItems"
                    placeholder="Search">
                <img src="~/images/icons/search-icon.svg" class="small-image anchor-tag  search-icon" alt="">
            </div>
            <div class="d-none d-md-flex gap-3 m-3">
                <div class=" d-flex gap-1 align-items-center">
                    <p class="veg-kot"></p>
                    <p>Vegiterian</p>
                </div>
                <div class=" d-flex gap-1 align-items-center">
                    <p class="nonveg-kot"></p>
                    <p>Non Vegiterian</p>
                </div>
                <div class=" d-flex gap-1 align-items-center">
                    <p class="vegan-kot"></p>
                    <p>Vegan</p>
                </div>
            </div>
        </div>
        <div id="kotMenuItemsListPartialStart">
            <partial name="_KotMenuItemsList" model="@Model" />

        </div>
    </div>
@if (Model.OrderDetailsCard != null)
{
        <div id="thisIsSecondImportant" class="bg-white d-none" style="height: 90vh;">
            <div class="p-3">
                @* header *@
                <div class="d-flex justify-content-between">
                    <div class="d-flex gap-1">
                        <div class="bg-for-table-image">
                            <img src="~/images/icons/kot-navbar-tables-black.svg" class="navbar-image p-2" alt="">
                        </div>
                        <div>
                            <p>@Model.OrderDetailsCard.SectionName</p>
                            <p><span class="font-weight-bold">Table:</span> <span>@Model.OrderDetailsCard.TableNames</span>
                            </p>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="table-card-kot-menu-icon-border cursor-pointer" data-bs-toggle="modal"
                            data-bs-target="#QrCodeMenuModal">
                            <img src="~/images/icons/kot-menu-qr-code.svg" class="navbar-image p-2" alt="">
                        </div>
                        <div class="table-card-kot-menu-icon-border cursor-pointer" onclick="getCustomerDetails()">
                            <img src="~/images/icons/kot-menu-customer-details.svg" class="navbar-image p-2" alt="">
                        </div>
                        <div class="table-card-kot-menu-icon-border cursor-pointer">
                            <img src="~/images/icons/kot-menu-comment.svg" class="navbar-image p-2" alt="">
                        </div>
                    </div>
                </div>
                @* ordered items section *@
                <div class="mt-3">
                    <div class="w-100 bg-white d-flex justify-content-start align-items-center px-3 py-2">
                        <p class="font-weight-bold color-head-order font-size-thead text-start w-50" style="margin-left: 6%;">Item</p>
                        <p class="font-weight-bold color-head-order font-size-thead" style="width: 15%; margin-left: 6.5%;">Quantity</p>
                        <p class="font-weight-bold color-head-order font-size-thead ps-4" style="width: 15%;">Amount</p>
                    </div>
                    @if (Model.OrderDetailsCard != null && Model.OrderDetailsCard.OrderItemDetails != null)
                    {
                        @foreach (var orderItem in Model.OrderDetailsCard.OrderItemDetails)
                        {
                            var customAccordionId = "collapse" + orderItem.ItemId;
                            <div class="accordion-item mb-2 div-custom-accordian">
                                <h2 class="accordion-header " id="headingOne">
                                <button class="accordion-button font-accordian" type="button" data-bs-toggle="collapse" data-bs-target="#@customAccordionId" aria-expanded="true" aria-controls="collapseOne">
                                    <div class="d-flex justify-content-between align-items-center w-100 font-accordian-head">
                                        <p class="w-50 font-weight-bold-slight">@orderItem.ItemName</p>
                                        <div class="quantity-card-order-items d-flex justify-content-center align-items-center p-1 mx-auto my-auto" style="width: 15%;">
                                            <p> <span class="p-2">-</span>@orderItem.ItemQuantity<span class="p-2">+</span></p>
                                        </div>
                                        <div style="width: 15%;" class="d-flex flex-column gap-2 font-accordian-head">
                                            <p>₹@orderItem.ItemTotalPrice</p>
                                            <p class="font-accordian">₹@orderItem.ModifiersTotalPrice</p>
                                        </div>
                                        <div onclick="deleteItemFromOrder(@orderItem.ItemId)">
                                            <img src="~/images/icons/delete.svg" class="small-image">
                                        </div>
                                    </div>
                                </button>
                                </h2>
                                <div id="@customAccordionId" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                    <table class="w-25">
                                        @foreach (var modifier in @orderItem.Modifiers)
                                        {
                                            <div class="d-flex align-items-center w-100 font-accordian gap-2">
                                                <tr class="">
                                                    <th></th>
                                                    <th></th>
                                                    <th></th>
                                                </tr>
                                                <tr class="font-accordian" >
                                                    <td>•</td>
                                                    <td>@modifier.ModifierName</td>
                                                    <td>@modifier.ModifierPrice</td>
                                                </tr>
                                            </div>
                                        }
                                    </table>
                                </div>
                                </div>
                            </div>
                        }
                    }
                    
                    </div>
                   
            </div>
        </div>
}


@* qr code modal *@
    <div class="modal fade" id="QrCodeMenuModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered qr-code-modal-width">
            <div class="modal-content">
                <div class="modal-body d-flex flex-column align-items-center justify-content-center">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="modal-title" id="staticBackdropLabel">Menu</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <img src="~/images/qr-code.png" style="width: 300px;" class="img-fluid p-4" alt="">
                    <a data-bs-dismiss="modal"><button type="button"
                            class="btn btn-contrast px-3 mt-4">Done</button></a>
                </div>
            </div>
        </div>
    </div>

@* customer details modal *@
    <div id="CustomerDetailsModalPartialStart1">
        <partial name="_CustomerDetailsModal" model="@Model" />
    </div>

@* select modifiers modal *@
    <div id="SelectModifiersPartialStaring">
        <partial name="_SelectModifiersModal" model="@Model" />
    </div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

    <script>

        function addToFavourites(id) {
            var itemId = parseInt(id.split("empty-heart-")[1]);
            $("#" + id).addClass('d-none');
            $("#filled-heart-" + itemId).removeClass('d-none');
            $.ajax({
                url: '/OrderAppMenu/AddToFavourites',
                type: 'PUT',
                data: { itemId: itemId },
                success: function (response) {
                    if (response.success) {
                        console.log(response.message)
                    } else {
                        console.error(response.message)
                    }
                },
                error: function () {
                    console.error("error adding item to favourites")
                }
            })
        }

        function removeFromFavourites(id) {
            var itemId = parseInt(id.split("filled-heart-")[1]);
            $("#" + id).addClass('d-none');
            $("#empty-heart-" + itemId).removeClass('d-none');
            $.ajax({
                url: '/OrderAppMenu/DeleteFromFavourites',
                type: 'DELETE',
                data: { itemId: itemId },
                success: function (response) {
                    if (response.success) {
                        if ($("#categoryIdKotMenu").val() == -2) {
                            $("#category-kot-favourite-items").click();
                        }
                    } else {
                        console.error(response.message)
                    }
                },
                error: function () {
                    console.error("error adding item to favourites")
                }
            })
        }

        var url = window.location.href;
        var orderId = url.substring(url.lastIndexOf('/') + 1);
        console.log(orderId == "Menu");
        if (orderId == "Menu") {
            document.getElementById("thisDivIsImportant").style.width = "100%";
            document.getElementById("thisIsSecondImportant").classList.add("d-none");
        }
        else {
            document.getElementById("thisDivIsImportant").style.width = "66%";
            document.getElementById("thisIsSecondImportant").classList.remove("d-none");
            document.getElementById("thisIsSecondImportant").style.width = "34%";
        }

        function getCustomerDetails() {
            $.ajax({
                url: '/OrderAppMenu/GetCustomerDetails',
                type: 'GET',
                data: { orderId: orderId },
                success: function (response) {
                    $("#CustomerDetailsModalPartialStart1").html(response);
                    $("#CustomerDetailsMenuModal").modal('show');
                    $.validator.unobtrusive.parse("#CustomerDetailsForm");
                    submitCustomerDetailsForm();
                },
                error: function () {
                    console.error("error fetching customer details")
                }
            })
        }

        function submitCustomerDetailsForm() {

            $('#CustomerDetailsForm').off('submit').on('submit', function (e) {
                e.preventDefault();
                var form = $(this);
                if (!$("#CustomerDetailsForm").valid()) {
                    return;
                }
                var formData = new FormData(this);
                $.ajax({
                    type: 'POST',
                    url: "/OrderAppMenu/UpdateCustomerDetails",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message);
                            $("#CustomerDetailsMenuModal").modal('hide');
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function () {
                        toastr.error("Error occurred while submitting the form.");
                    }
                });
            });
        }

        function deleteItemFromOrder(itemId) {
            console.log(itemId);
            $.ajax({
                url: '/OrderAppMenu/DeleteItemFromOrder',
                type: 'DELETE',
                data: { orderId: orderId, itemId: itemId },
                success: function (response) {
                    if (response.success) {
                        window.location.reload();
                    } else {
                        console.error(response.message)
                    }
                },
                error: function () {
                    console.error("error deleting item from order")
                }
            })
        }

    </script>