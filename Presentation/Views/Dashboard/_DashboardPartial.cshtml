@model DAL.ViewModels.DashboardViewModel

<!-- 4 - tiles -->
<div class="row d-flex  justify-content-md-center align-items-center justify-content-around">
    <!-- tile -->
    <div class="col-10 col-sm-5 m-2 col-lg-3   form-bg   shadow tile-group-4">
        <!-- tile-image -->
        <div class="d-flex justify-content-end align-items-center m-2">
            <div class="tiles-image-outer-border d-flex  justify-content-center align-items-center">
                <div class="tiles-image-border tile-green d-flex justify-content-center align-items-center">
                    <img src="~/images/icons/total-sales.svg" class="tiles-image " alt="">
                </div>
            </div>
        </div>
        <!-- tile-content -->
        <div class="pb-1 ps-2 tile-content">
            <h3 class=" tile-heading">₹@Model.TotalSales</h3>
            <p class="tile-paragraph">Total Sales</p>
        </div>
    </div>
    <div class="col-10 col-sm-5 m-2 col-lg-3   form-bg   shadow tile-group-4">
        <!-- tile-image -->
        <div class="d-flex justify-content-end align-items-center m-2">
            <div class="tiles-image-outer-border d-flex  justify-content-center align-items-center">
                <div class="tiles-image-border tile-blue d-flex justify-content-center align-items-center">
                    <img src="~/images/icons/total-orders.svg" class="tiles-image " alt="">
                </div>
            </div>
        </div>
        <!-- tile-content -->
        <div class="pb-1 ps-2 tile-content">
            <h3 class=" tile-heading">@Model.TotalOrders</h3>
            <p class="tile-paragraph">Total Orders</p>
        </div>
    </div>
    <div class="col-10 col-sm-5 m-2 col-lg-3   form-bg   shadow tile-group-4">
        <!-- tile-image -->
        <div class="d-flex justify-content-end align-items-center m-2">
            <div class="tiles-image-outer-border d-flex  justify-content-center align-items-center">
                <div class="tiles-image-border tile-sky-blue d-flex justify-content-center align-items-center">
                    <img src="~/images/icons/order-value.svg" class="tiles-image " alt="">
                </div>
            </div>
        </div>
        <!-- tile-content -->
        <div class="pb-1 ps-2 tile-content">
            <h3 class=" tile-heading">₹@Model.AverageOrderValue</h3>
            <p class="tile-paragraph">Avg. Order Value</p>
        </div>
    </div>
    <div class="col-10 col-sm-5 m-2 col-lg-3   form-bg   shadow tile-group-4">
        <!-- tile-image -->
        <div class="d-flex justify-content-end align-items-center m-2">
            <div class="tiles-image-outer-border d-flex  justify-content-center align-items-center">
                <div class="tiles-image-border tile-orange d-flex justify-content-center align-items-center">
                    <img src="~/images/icons/waiting-time.svg" class="tiles-image " alt="">
                </div>
            </div>
        </div>
        <!-- tile-content -->
        <div class="pb-1 ps-2 tile-content">
            <h3 class=" tile-heading">@Model.AverageWaitingTime</h3>
            <p class="tile-paragraph">Average Waiting Time</p>
        </div>
    </div>

</div>

<!-- 2 - tiles -->
<div class="row d-flex  justify-content-md-center align-items-center justify-content-around">
    <!-- tile -->
    <div class="col-10 m-2 col-lg-6   form-bg   shadow tile-group-2 p-2" style="height: 415px;">
        <h3>Revenue</h3>
        <div class="chart-container" style=" width:100%">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>
    <!-- tile -->
    <div class="col-10 m-2 col-lg-6   form-bg   shadow tile-group-2 p-2" style="height: 415px;">
        <h3>Customer Growth</h3>
        <div class="chart-container" style=" width:100%">
            <canvas id="customerGrowthChart"></canvas>
        </div>
    </div>
</div>
<!-- 4 - tiles -->
<div class="row d-flex  justify-content-md-center align-items-start justify-content-around">
    <!-- tile -->
    <div class="col-10 col-sm-5 m-2 col-lg-3   form-bg   shadow tile-group-4-bottom">
        <!-- tile-image -->
        <div class="d-flex flex-column justify-content-start align-items-start p-2 m-2">
            <h4 class="mb-3">Top Selling Items</h4>
            <div class="d-flex flex-column gap-2">
                <div class="d-flex justify-content-start align-items-center gap-1">
                    <p>#1</p>
                    @{
                        string profileImagePath = string.IsNullOrEmpty(@Model.TopSellingItems?[0].ImageUrl)
                        ? "/images/dining-menu.png"
                        : $"/images/item-images/{@Model.TopSellingItems?[0].ImageUrl}";
                    }
                    <img src="@profileImagePath" class="table-name-image profile-image-border object-fit-cover" alt="">
                    <div>
                        <p class="text-small">@Model.TopSellingItems?[0].Name</p>
                        <p class="text-small">@Model.TopSellingItems?[0].NumberOfOrders order(s)</p>
                    </div>
                </div>
                <div class="d-flex justify-content-start align-items-center gap-1">
                    <p>#2</p>
                    @{
                        string profileImagePath2 = string.IsNullOrEmpty(@Model.TopSellingItems?[1].ImageUrl)
                        ? "/images/dining-menu.png"
                        : $"/images/item-images/{@Model.TopSellingItems?[1].ImageUrl}";
                    }
                    <img src="@profileImagePath2" class="table-name-image profile-image-border object-fit-cover" alt="">
                    <div>
                        <p class="text-small">@Model.TopSellingItems?[1].Name</p>
                        <p class="text-small">@Model.TopSellingItems?[1].NumberOfOrders order(s)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- tile -->
    <div class="col-10 col-sm-5 m-2 col-lg-3   form-bg   shadow tile-group-4-bottom">
        <!-- tile-image -->
        <div class="d-flex flex-column justify-content-start align-items-start p-2 m-2">
            <h4 class="mb-3">Least Selling Items</h4>
            <div class="d-flex flex-column gap-2">
                <div class="d-flex justify-content-start align-items-center gap-1">
                    <p>#1</p>
                    @{
                        string profileImagePath3 = string.IsNullOrEmpty(@Model.LeastSellingItems?[0].ImageUrl)
                        ? "/images/dining-menu.png"
                        : $"/images/item-images/{@Model.LeastSellingItems?[0].ImageUrl}";
                    }
                    <img src="@profileImagePath3" class="table-name-image profile-image-border object-fit-cover" alt="">
                    <div>
                        <p class="text-small">@Model.LeastSellingItems?[0].Name</p>
                        <p class="text-small">@Model.LeastSellingItems?[0].NumberOfOrders order(s)</p>
                    </div>
                </div>
                <div class="d-flex justify-content-start align-items-center gap-1">
                    <p>#2</p>
                    @{
                        string profileImagePath4 = string.IsNullOrEmpty(@Model.LeastSellingItems?[1].ImageUrl)
                        ? "/images/dining-menu.png"
                        : $"/images/item-images/{@Model.LeastSellingItems?[1].ImageUrl}";
                    }
                    <img src="@profileImagePath4" class="table-name-image profile-image-border object-fit-cover" alt="">
                    <div>
                        <p class="text-small">@Model.LeastSellingItems?[1].Name</p>
                        <p class="text-small">@Model.LeastSellingItems?[1].NumberOfOrders order(s)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-10 col-sm-5 m-2 col-lg-3 form-bg shadow tile-group-4-bottom waiting-list-dashboard">
        <!-- tile-image -->
        <div class="d-flex justify-content-end align-items-center m-2">
            <div class="tiles-image-outer-border d-flex  justify-content-center align-items-center">
                <div class="tiles-image-border tile-green d-flex justify-content-center align-items-center">
                    <img src="~/images/icons/sand-timer.svg" class="tiles-image " alt="">
                </div>
            </div>
        </div>
        <!-- tile-content -->
        <div class="pb-1 ps-2 tile-content"">
            <h3 class=" tile-heading">@Model.WaitingListCount</h3>
            <p class="tile-paragraph">Waiting List Count</p>
        </div>
    </div>
    <div class="col-10 col-sm-5 m-2 col-lg-3 form-bg shadow tile-group-4-bottom waiting-list-dashboard">
        <!-- tile-image -->
        <div class="d-flex justify-content-end align-items-center m-2">
            <div class="tiles-image-outer-border d-flex  justify-content-center align-items-center">
                <div class="tiles-image-border tile-orange d-flex justify-content-center align-items-center">
                    <img src="@Url.Content("~/images/icons/account-dashboard.svg")" class="tiles-image"
                        style="height: 25px;" alt="">
                </div>
            </div>
        </div>
        <!-- tile-content -->
        <div class="pb-1 ps-2 tile-content"">
            <h3 class=" tile-heading">@Model.NewCustomerCount</h3>
            <p class="tile-paragraph">New Customer(s) Count</p>
        </div>
    </div>

</div>

<script>
    var ctx = document.getElementById('revenueChart').getContext('2d');
    var revenueData = @Html.Raw(Json.Serialize(Model.RevenueData));
    var revenueChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: revenueData.labels,
            datasets: [{
                label: 'Revenue',
                data: revenueData.values,
                borderColor: 'rgba(75, 192, 192, 1)',
                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                borderWidth: 2,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    display: true,
                    position: 'top'
                }
            },
            scales: {
                x: {
                    title: {
                        display: true,
                        text: 'Days'
                    }
                },
                y: {
                    title: {
                        display: true,
                        text: 'Revenue'
                    },
                    beginAtZero: true
                }
            }
        }
    });

    var ctx2 = document.getElementById('customerGrowthChart').getContext('2d');
    var customerGrowthData = @Html.Raw(Json.Serialize(Model.CustomerGrowthData));
    var customerGrowthChart = new Chart(ctx2, {
        type: 'line',
        data: {
            labels: customerGrowthData.labels,
            datasets: [{
                label: 'Customer Growth',
                data: customerGrowthData.values,
                borderColor: 'rgba(153, 102, 255, 1)',
                backgroundColor: 'rgba(153, 102, 255, 0.2)',
                borderWidth: 2,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    display: true,
                    position: 'top'
                }
            },
            scales: {
                x: {
                    title: {
                        display: true,
                        text: 'Days'
                    }
                },
                y: {
                    title: {
                        display: true,
                        text: 'Customer Count'
                    },
                    beginAtZero: true
                }
            }
        }
    });
</script>