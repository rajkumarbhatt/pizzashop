@model DAL.ViewModels.DashboardViewModel

<!-- 4 - tiles -->
<div class="row d-flex  justify-content-md-center align-items-center justify-content-around">
    <!-- tile -->
    <div class="col-10 col-sm-5 m-2 col-lg-3   form-bg   shadow tile-group-4">
        <!-- tile-image -->
        <div class="d-flex justify-content-end align-items-center m-2">
            <div class="tiles-image-outer-border d-flex  justify-content-center align-items-center">
                <div class="tiles-image-border tile-green d-flex justify-content-center align-items-center">
                    <img src="~/images/icons/total-sales.svg" class="tiles-image " alt="">
                </div>
            </div>
        </div>
        <!-- tile-content -->
        <div class="pb-1 ps-2 tile-content">
            <h3 class=" tile-heading">₹@Model.TotalSales</h3>
            <p class="tile-paragraph">Total Sales</p>
        </div>
    </div>
    <div class="col-10 col-sm-5 m-2 col-lg-3   form-bg   shadow tile-group-4">
        <!-- tile-image -->
        <div class="d-flex justify-content-end align-items-center m-2">
            <div class="tiles-image-outer-border d-flex  justify-content-center align-items-center">
                <div class="tiles-image-border tile-blue d-flex justify-content-center align-items-center">
                    <img src="~/images/icons/total-orders.svg" class="tiles-image " alt="">
                </div>
            </div>
        </div>
        <!-- tile-content -->
        <div class="pb-1 ps-2 tile-content">
            <h3 class=" tile-heading">@Model.TotalOrders</h3>
            <p class="tile-paragraph">Total Orders</p>
        </div>
    </div>
    <div class="col-10 col-sm-5 m-2 col-lg-3   form-bg   shadow tile-group-4">
        <!-- tile-image -->
        <div class="d-flex justify-content-end align-items-center m-2">
            <div class="tiles-image-outer-border d-flex  justify-content-center align-items-center">
                <div class="tiles-image-border tile-sky-blue d-flex justify-content-center align-items-center">
                    <img src="~/images/icons/order-value.svg" class="tiles-image " alt="">
                </div>
            </div>
        </div>
        <!-- tile-content -->
        <div class="pb-1 ps-2 tile-content">
            <h3 class=" tile-heading">₹@Model.AverageOrderValue</h3>
            <p class="tile-paragraph">Avg. Order Value</p>
        </div>
    </div>
    <div class="col-10 col-sm-5 m-2 col-lg-3   form-bg   shadow tile-group-4">
        <!-- tile-image -->
        <div class="d-flex justify-content-end align-items-center m-2">
            <div class="tiles-image-outer-border d-flex  justify-content-center align-items-center">
                <div class="tiles-image-border tile-orange d-flex justify-content-center align-items-center">
                    <img src="~/images/icons/waiting-time.svg" class="tiles-image " alt="">
                </div>
            </div>
        </div>
        <!-- tile-content -->
        <div class="pb-1 ps-2 tile-content">
            <h3 class=" tile-heading">@Model.AverageWaitingTime</h3>
            <p class="tile-paragraph">Average Waiting Time</p>
        </div>
    </div>

</div>

<!-- 2 - tiles -->
<div class="row d-flex  justify-content-md-center align-items-center justify-content-around">
    <!-- tile -->
    <div class="col-10 m-2 col-lg-6   form-bg   shadow tile-group-2 p-2" style="height: 100%;">
        <h3>Revenue</h3>
        <div class="chart-container">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>
    <!-- tile -->
    <div class="col-10 m-2 col-lg-6   form-bg   shadow tile-group-2 p-2" style="height: 100%;">
        <h3>Customer Growth</h3>
        <div class="chart-container">
            <canvas id="customerGrowthChart"></canvas>
        </div>
    </div>
</div>
<!-- 4 - tiles -->
<div class="row d-flex  justify-content-md-center align-items-start justify-content-around">
    <!-- tile -->
    <div class="col-10 col-sm-5 m-2 col-lg-3 form-bg shadow tile-group-4-bottom" style="height: 172.8px;">
        <!-- tile-image -->
        <div class="d-flex flex-column justify-content-start align-items-start p-2 m-2">
            <h4 class="mb-3">Top Selling Items</h4>
            <div class="d-flex flex-column gap-2">
                @{
                    var j = 1;
                }
                @foreach (var item in Model.TopSellingItems)
                {
                    string profileImagePath3 = string.IsNullOrEmpty(@item.ImageUrl)
                    ? "/images/dining-menu.png"
                    : $"/images/item-images/{@item.ImageUrl}";
                    <div class="d-flex justify-content-start align-items-center gap-1">
                        <div class="d-flex justify-content-start align-items-center gap-1">
                            <p>#@j</p>
                            <img src="@profileImagePath3" class="table-name-image profile-image-border object-fit-cover"
                                alt="">
                            <div>
                                <p class="text-small">@item.Name</p>
                                <p class="text-small">@item.NumberOfOrders order(s)</p>
                            </div>
                        </div>
                    </div>
                    j++;
                }
            </div>
        </div>
    </div>
    <!-- tile -->
    <div class="col-10 col-sm-5 m-2 col-lg-3 form-bg shadow tile-group-4-bottom" style="height: 172.8px;">
        <!-- tile-image -->
        <div class="d-flex flex-column justify-content-start align-items-start p-2 m-2">
            <h4 class="mb-3">Least Selling Items</h4>
            <div class="d-flex flex-column gap-2">
                @{
                    var i = 1;
                }
                @foreach (var item in Model.LeastSellingItems)
                {
                    string profileImagePath3 = string.IsNullOrEmpty(@item.ImageUrl)
                    ? "/images/dining-menu.png"
                    : $"/images/item-images/{@item.ImageUrl}";
                    <div class="d-flex justify-content-start align-items-center gap-1">
                        <p>#@i</p>
                        <img src="@profileImagePath3" class="table-name-image profile-image-border object-fit-cover" alt="">
                        <div>
                            <p class="text-small">@item.Name</p>
                            <p class="text-small">@item.NumberOfOrders order(s)</p>
                        </div>
                    </div>
                    i++;
                }
            </div>
        </div>
    </div>
    <div class="col-10 col-sm-5 m-2 col-lg-3 form-bg shadow tile-group-4-bottom waiting-list-dashboard">
        <!-- tile-image -->
        <div class="d-flex justify-content-end align-items-center m-2">
            <div class="tiles-image-outer-border d-flex  justify-content-center align-items-center">
                <div class="tiles-image-border tile-green d-flex justify-content-center align-items-center">
                    <img src="~/images/icons/sand-timer.svg" class="tiles-image " alt="">
                </div>
            </div>
        </div>
        <!-- tile-content -->
        <div class="pb-1 ps-2 tile-content"">
            <h3 class=" tile-heading">@Model.WaitingListCount</h3>
            <p class="tile-paragraph">Waiting List Count</p>
        </div>
    </div>
    <div class="col-10 col-sm-5 m-2 col-lg-3 form-bg shadow tile-group-4-bottom waiting-list-dashboard">
        <!-- tile-image -->
        <div class="d-flex justify-content-end align-items-center m-2">
            <div class="tiles-image-outer-border d-flex  justify-content-center align-items-center">
                <div class="tiles-image-border tile-orange d-flex justify-content-center align-items-center">
                    <img src="@Url.Content("~/images/icons/account-dashboard.svg")" class="tiles-image"
                        style="height: 25px;" alt="">
                </div>
            </div>
        </div>
        <!-- tile-content -->
        <div class="pb-1 ps-2 tile-content"">
            <h3 class=" tile-heading">@Model.NewCustomerCount</h3>
            <p class="tile-paragraph">New Customer(s) Count</p>
        </div>
    </div>

</div>

<script>
    var revenueData = @Html.Raw(Json.Serialize(Model.RevenueData));
    var customerGrowthData = @Html.Raw(Json.Serialize(Model.CustomerGrowthData));
</script>
<script src="~/js/dashboardCharts.js"></script>