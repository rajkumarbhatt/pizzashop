@model DAL.ViewModels.DashboardViewModel

<!-- user heading and dropdown -->
<div class="row d-flex justify-content-between align-items-center">
    <h1 class=" col-6 col-sm-8 col-lg-9 main-page-heading">Dashboard</h1>
    <!-- dropdown -->
    <div class="col pe-2">
        <select name="select-duration" id="select-duration" class="form-select" aria-label="Select Duration"
            onfocus="this.selectedIndex=-1;">
            <option value="Current Month" selected>Current Month</option>
            <option value="Last 7 Days">Last 7 Days</option>
            <option value="Last 30 Days">Last 30 Days</option>
            <option value="This Year">Last Year</option>
            <option value="Today">Today</option>
            <option value="Custom Date">Custom Date</option>
        </select>
    </div>
</div>

<div id="dashboardPartialStarting">
    <partial name="_DashboardPartial" model="Model" />
</div>

@* custom datepicker modal *@
<div class="modal fade" id="CustomDatepickerModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Select Date Range</h5>
                <button id="closeDatePickerModalButton" type="button" class="btn-close" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex mx-auto gap-3">
                <div class="d-flex flex-column ">
                    <div class="input-group search-box cursor-pointer" style="width: 200px;">
                        <div class="form-floating">
                            <input type="text" class="form-control cursor-pointer search-input datepicker"
                                style="height: 44px;" id="fromDate" value="dd-mm-yyyy">
                            <label for="fromDate" class="form-label cursor-pointer">From Date</label>
                        </div>
                        <img src="~/images/icons/calender.svg" class="small-image cursor-pointer anchor-tag search-icon"
                            alt="">
                    </div>
                    <span class="text-danger" id="errorMessageFromDate"></span>
                </div>
                <div class="d-flex flex-column">
                    <div class="input-group search-box cursor-pointer" style="width: 200px;">
                        <div class="form-floating">
                            <input type="text" class="form-control cursor-pointer search-input datepicker"
                                style="height: 44px;" id="toDate" value="dd-mm-yyyy">
                            <label for="toDate" class="form-label cursor-pointer">To Date</label>
                        </div>
                        <img src="~/images/icons/calender.svg" class="small-image cursor-pointer anchor-tag search-icon"
                            alt="">
                    </div>
                    <span class="text-danger" id="errorMessageToDate"></span>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-center">
                <button id="ApplyDateChangesButton" type="submit" class="btn btn-primary px-3">Submit</button>
                <a><button data-bs-dismiss="modal" aria-label="Close" type="button" id="cancelDatePickerButton"
                        class="btn btn-contrast px-3">Cancel</button></a>
            </div>
        </div>
    </div>
</div>

<script src="~/js/dashboard.js" asp-append-version="true"></script>