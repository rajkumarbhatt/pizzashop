@model DAL.ViewModels.CustomerViewModel
<table id="ordersTable" class="table table-responsive table-hover"  style="white-space: nowrap;">
        <thead class="color-head-order">
            <tr class="text-start">
                <th>Name <img src="~/images/icons/sorting-icon-table.svg" id="sortNameCustomer" class="small-image"></th>
                <th>Email</th>
                <th>Phone Number</th>
                <th>Date <img src="~/images/icons/sorting-icon-table.svg" id="sortCustomerDate" class="small-image"></th>
                <th>Total Order <img src="~/images/icons/sorting-icon-table.svg" id="sortTotalOrdersCustomers" class="small-image"></th>
            </tr>
        </thead>
    <tbody>
        @if (@Model.Customers.Count() == 0)
        {
            <tr>
                <td colspan="5" class="text-center font-weight-bold-slight">No Customers Found</td>
            </tr>
        }
        @foreach(var customer in @Model.Customers)
        {
            <tr class="cursor-pointer" onclick="showCustomerDetails(@customer.Id)">
                <td>@customer.Name</td>
                <td>@customer.Email</td>
                <td>@customer.PhoneNumber</td>
                <td>@customer.Date</td>
                <td>@customer.TotalOrders</td>
            </tr>
        }
    </tbody>
</table>


<div class="d-flex flex-column flex-sm-row align-items-center justify-content-end g-3 me-sm-5">
    <div class="d-flex align-items-center gap-2">
        <p>Items per page: </p>
        <select class="form-select pagination-dropdown text-black" aria-label="Items per page"
            onchange="changePageSizeOrders(this.value)" id="pageSizeSelectOrders">
            <option value="5" selected="@(Model.pageSize == 5 ? "selected" : null)">5</option>
            <option value="10" selected="@(Model.pageSize == 10 ? "selected" : null)">10</option>
            <option value="15" selected="@(Model.pageSize == 15 ? "selected" : null)">15</option>
        </select>
    </div>
    <p class="px-1">
        Showing @(Model.totalPages == 0 ? 0 : (Model.pageIndex - 1) * Model.pageSize + 1) - 
        @(Math.Min(Model.pageIndex * Model.pageSize, Model.totalCustomers)) of 
        @Model.totalCustomers
    </p>
    <div class="d-flex gap-2 gap-sm-0">
        <button id="previousButtonOrders" class="p-1 px-2" @(Model.pageIndex == 1 ? "disabled" : "")>&lt;</button>
        <button id="nextButtonOrders" class="p-1 px-2 ms-1 border-1 border-secondary" @(Model.pageIndex == Model.totalPages ? "disabled" : "")>&gt;</button>
    </div>    
</div>

<script>
    var pageIndexOfModal = @Model.pageIndex;
    var pageSizeOfModal = @Model.pageSize;
</script>
<script src="/js/customersPartial.js" asp-append-version="true"></script>